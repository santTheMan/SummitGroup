---
/**
 * Header: a floating pill centred at the top of the screen, holding the logo,
 * the "Our businesses" fold-out, the section links and the Book a conversation
 * button. A frosted squircle capsule over the page; on small screens it keeps
 * the logo and a menu button, and the sheet opens beneath it.
 * Emil's details: the fold-out grows from its trigger and closes faster than it
 * opens, links and buttons press in, hover effects only on devices that hover.
 * Behaviour: src/scripts/ui.ts.
 */
import lockup from '../assets/brand/SGI-lockup-colour.svg';
import { brand, businesses, navigation } from '../content/site.ts';
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';

const lockupHeight = 22;
const lockupWidth = Math.round((lockup.width / lockup.height) * lockupHeight);
const icons = { institute: 'institute', sales: 'sales', pathways: 'pathways' } as const;
---

<header class="nav" data-nav>
  <div class="pill">
    <a class="nav-brand" href="#top" aria-label={`${brand.name}, back to top`}>
      <img src={lockup.src} width={lockupWidth} height={lockupHeight} alt={brand.name} />
    </a>

    <nav class="nav-links" aria-label="Main">
      <div class="biz" data-biz-menu>
        <button class="nav-link" type="button" aria-expanded="false" aria-controls="biz-panel" data-biz-trigger>
          {navigation.businessesLabel}
          <Icon name="chevron" size={16} class="caret" />
        </button>
        <div class="biz-panel" id="biz-panel" data-biz-panel>
          <ul>
            {
              businesses.map((b) => (
                <li>
                  <a class="biz-item" href={`#business-${b.id}`} style={`--c: var(--c-${b.id}); --ci: var(--c-${b.id}-ink)`}>
                    <span class="biz-ic">
                      <Icon name={icons[b.id]} />
                    </span>
                    <span>
                      <b>{b.name}</b>
                      <small>{b.role}</small>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      {
        navigation.links.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <CtaButton size="small" class="nav-cta" />
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-sheet"
      aria-label={navigation.menuLabel}
      data-burger
    >
      <Icon name="menu" class="burger-open" />
      <Icon name="close" class="burger-close" />
    </button>

    <nav class="sheet" id="nav-sheet" aria-label="Site menu" data-sheet>
      <p class="k sheet-k">{navigation.businessesLabel}</p>
      {
        businesses.map((b) => (
          <a href={`#business-${b.id}`}>
            {b.name}
            <small>{b.role}</small>
          </a>
        ))
      }
      <hr />
      {
        navigation.links.map((link) => (
          <a href={link.href}>
            {link.label}
            <Icon name="arrow" size={16} />
          </a>
        ))
      }
      <CtaButton class="sheet-cta" />
    </nav>
  </div>
</header>

<style>
  /* The bar spans the page but is invisible; only the centred pill takes clicks. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0.75rem var(--gutter) 0;
    pointer-events: none;
  }

  .pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 3.5rem;
    padding: 0 0.4375rem 0 1.125rem;
    border-radius: 999px;
    corner-shape: squircle;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--rule) 80%, transparent);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 12px 32px -20px rgb(7 27 52 / 0.35);
    backdrop-filter: saturate(1.5) blur(16px);
    -webkit-backdrop-filter: saturate(1.5) blur(16px);
    pointer-events: auto;
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease;
  }

  .nav[data-scrolled] .pill {
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 16px 40px -20px rgb(7 27 52 / 0.45);
  }

  .nav-brand {
    display: inline-flex;
    flex: none;
    margin-right: 1rem;
    border-radius: 6px;
  }

  .nav-brand img {
    height: 22px;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-right: 0.75rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--ink) 82%, transparent);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform var(--press) var(--ease-out);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  .nav-link[aria-expanded='true'] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }

    .biz-item:hover {
      background: var(--page);
    }
  }

  .nav-link :global(.caret) {
    transition: transform 200ms var(--ease-out);
  }

  .nav-link[aria-expanded='true'] :global(.caret) {
    transform: rotate(180deg);
  }

  .biz {
    position: relative;
  }

  /* Origin-aware: the panel grows from its trigger. Opens in 200ms, closes faster. */
  .biz-panel {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: 50%;
    width: 22.5rem;
    margin-left: -11.25rem;
    padding: 0.5rem;
    border-radius: 20px;
    corner-shape: squircle;
    background: var(--paper);
    border: 1px solid var(--rule);
    box-shadow: 0 30px 60px -30px rgb(7 27 52 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.97);
    transform-origin: 50% 0;
    transition:
      opacity 150ms ease,
      transform 150ms var(--ease-out),
      visibility 150ms;
  }

  .biz-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1rem;
    height: 1rem;
  }

  .biz-panel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-duration: 200ms;
  }

  .biz-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 12px;
    transition: background-color 150ms ease;
  }

  .biz-item b {
    display: block;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .biz-item small {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .biz-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    corner-shape: squircle;
    background: color-mix(in srgb, var(--c) 14%, var(--page));
    color: var(--ci);
  }

  .burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border-radius: 999px;
    transition: transform var(--press) var(--ease-out);
  }

  .burger:active {
    transform: scale(0.95);
  }

  .burger :global(.burger-close),
  .burger[aria-expanded='true'] :global(.burger-open) {
    display: none;
  }

  .burger[aria-expanded='true'] :global(.burger-close) {
    display: block;
  }

  .sheet {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .pill {
      width: 100%;
      max-width: 34rem;
      padding-right: 0.4375rem;
    }

    .nav-links,
    .pill > :global(.nav-cta) {
      display: none;
    }

    .burger {
      display: grid;
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 0.5rem);
      display: flex;
      flex-direction: column;
      padding: 0.5rem;
      border-radius: 22px;
      corner-shape: squircle;
      background: var(--paper);
      border: 1px solid var(--rule);
      box-shadow: 0 30px 60px -30px rgb(7 27 52 / 0.4);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transform-origin: top center;
      transition:
        opacity 150ms ease,
        transform 150ms var(--ease-out),
        visibility 150ms;
    }

    .sheet[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-duration: 220ms;
    }

    .sheet-k {
      padding: 0.75rem 0.75rem 0.25rem;
    }

    .sheet a:not(.button) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.8rem 0.75rem;
      border-radius: 12px;
      font-size: 0.9375rem;
    }

    .sheet a small {
      font-size: 0.78rem;
      color: var(--muted);
      text-align: right;
    }

    .sheet hr {
      width: calc(100% - 1.5rem);
      margin: 0.25rem auto;
      border: 0;
      border-top: 1px solid var(--rule);
    }

    .sheet :global(.sheet-cta) {
      margin: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .burger {
      transition: none;
    }
  }
</style>
