---
/**
 * Header: a floating pill centred at the top of the screen, holding the logo,
 * the "Our businesses" fold-out and the section links (no booking button: the
 * page's own calls to action carry that). A Liquid Glass capsule over the
 * page; on small screens it keeps the logo and a menu button, and the sheet
 * opens beneath it. The sheet carries no booking button either (Daniel removed
 * it on 24 Nov 2026): it holds only the businesses and the section links.
 * Selection (after Apple's glass tab bars): a quiet fill sits under the section
 * you are reading and slides to the link under the pointer; pressed, it lifts
 * into a glass lens and swells.
 * Material (23 Nov 2026, to Apple's Liquid Glass guidance): the header is the
 * navigation layer, so it is the glass. The bar, the "Our businesses" fold-out
 * and the small-screen sheet are Regular glass (tokens.css --glass-*); the
 * menus materialize as they open. What sits on the bar (the selection, the menu
 * button) uses fills, never glass on glass, and the selection lifts into a glass
 * lens only while pressed. A scroll edge effect softens content passing under it.
 * Emil's details: the fold-out grows from its trigger and closes faster than it
 * opens, links and buttons press in, hover effects only on devices that hover.
 * Behaviour: src/scripts/ui.ts.
 */
import lockup from '../assets/brand/SGI-lockup-colour.svg';
import { brand, businesses, navigation } from '../content/site.ts';
import Icon from './Icon.astro';

const lockupHeight = 22;
const lockupWidth = Math.round((lockup.width / lockup.height) * lockupHeight);
const icons = { institute: 'institute', sales: 'sales', pathways: 'pathways' } as const;
---

<header class="nav" data-nav>
  <div class="pill">
    <a class="nav-brand" href="#top" aria-label={`${brand.name}, back to top`}>
      <img src={lockup.src} width={lockupWidth} height={lockupHeight} alt={brand.name} />
    </a>

    <nav class="nav-links" aria-label="Main" data-nav-links>
      <span class="nav-glass" aria-hidden="true" data-nav-glass></span>
      <div class="biz" data-biz-menu>
        <button
          class="nav-link"
          type="button"
          aria-expanded="false"
          aria-controls="biz-panel"
          data-biz-trigger
          data-nav-item="businesses"
        >
          {navigation.businessesLabel}
          <Icon name="chevron" size={16} class="caret" />
        </button>
        <div class="biz-panel" id="biz-panel" data-biz-panel>
          <ul>
            {
              businesses.map((b) => (
                <li>
                  <a class="biz-item" href={`#business-${b.id}`} style={`--c: var(--c-${b.id}); --ci: var(--c-${b.id}-ink)`}>
                    <span class="biz-ic">
                      <Icon name={icons[b.id]} />
                    </span>
                    <span>
                      <b>{b.name}</b>
                      <small>{b.role}</small>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      {
        navigation.links.map((link) => (
          <a class="nav-link" href={link.href} data-nav-item={link.href.slice(1)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-sheet"
      aria-label={navigation.menuLabel}
      data-burger
    >
      <Icon name="menu" class="burger-open" />
      <Icon name="close" class="burger-close" />
    </button>

    <nav class="sheet" id="nav-sheet" aria-label="Site menu" data-sheet>
      <p class="k sheet-k">{navigation.businessesLabel}</p>
      {
        businesses.map((b) => (
          <a href={`#business-${b.id}`}>
            {b.name}
            <small>{b.role}</small>
          </a>
        ))
      }
      <hr />
      {
        navigation.links.map((link) => (
          <a href={link.href}>
            {link.label}
            <Icon name="arrow" size={16} />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* The bar spans the page but is invisible; only the centred pill takes clicks. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0.75rem var(--gutter) 0;
    pointer-events: none;
  }

  /* Scroll edge effect (Apple's alternative to a hard divider): once the page has
     scrolled, content passing under the header softly blurs and fades into the page
     colour, so the glass bar always floats over a calm ground. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 5.5rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--page) 70%, transparent), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent);
    mask-image: linear-gradient(180deg, #000 35%, transparent);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .nav[data-scrolled]::before {
    opacity: 1;
  }

  /* The bar: transparent frosted glass (Daniel, 23 Nov 2026), the navigation layer
     floating over the page. Nearly clear, so the page shows through, heavily frosted
     so the links stay easy to read (the scroll edge effect softens what passes
     under it); a specular rim catches
     the light (brightest at the top, and following the pointer on desktop, set by
     ui.ts); a soft inner shade gives it thickness. Its shadow deepens once it floats
     over content. The glass lives on a layer under the bar (::before), not on the
     bar itself: an element with its own backdrop-filter becomes the "backdrop root"
     of everything inside it, and the fold-out and the phone menu would then blur
     only the bar, not the page behind them. */
  .pill {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 3.5rem;
    padding: 0 0.5rem 0 1.125rem;
    border-radius: 999px;
    box-shadow:
      0 0 0 0.5px rgb(7 27 52 / 0.06),
      0 8px 24px -16px rgb(7 27 52 / 0.28);
    pointer-events: auto;
    transition: box-shadow 300ms ease;
  }

  .pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-sheen), var(--glass-clear);
    box-shadow: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur-clear);
    backdrop-filter: var(--glass-blur-clear);
    pointer-events: none;
  }

  .nav[data-scrolled] .pill {
    box-shadow:
      0 0 0 0.5px rgb(7 27 52 / 0.08),
      0 16px 40px -18px rgb(7 27 52 / 0.42);
  }

  .nav-brand {
    display: inline-flex;
    flex: none;
    margin-right: 1rem;
    border-radius: 6px;
  }

  .nav-brand img {
    height: 22px;
    width: auto;
  }

  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  /*
   * The selection, as on Apple's glass tab bars. Never glass on glass: at rest it is
   * a quiet fill on the bar. While a link is pressed it lifts into a Liquid Glass
   * lens (data-lift, set by ui.ts), swelling and catching the light, then settles
   * back to a fill. Position, width and press are driven by ui.ts (Motion springs).
   */
  .nav-glass {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 2.5rem;
    margin-top: -1.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    opacity: 0;
    pointer-events: none;
    will-change: transform, width;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .nav-glass[data-lift] {
    background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.5), rgb(232 242 255 / 0.2));
    box-shadow:
      var(--glass-thick),
      0 0 0 0.5px rgb(7 27 52 / 0.06),
      0 8px 18px -8px rgb(7 27 52 / 0.3);
    -webkit-backdrop-filter: blur(2px) saturate(2.2) brightness(1.08);
    backdrop-filter: blur(2px) saturate(2.2) brightness(1.08);
  }

  /* The lit rim: a 1px ring of light, brightest where it meets the light (and, on the
     bar, leaning toward the pointer). A masked ring, so the gradient never washes
     over the glass inside it. It doubles as the hairline border under Reduce
     Transparency and Increase Contrast. */
  .pill::after,
  .biz-panel::after,
  .sheet::after,
  .nav-glass[data-lift]::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: var(--glass-rim);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .nav-links > :not(.nav-glass) {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--ink) 82%, transparent);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform var(--press) var(--ease-out);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  /* The glass lens is the highlight; the selected link's text goes full ink */
  .nav-link[aria-expanded='true'],
  .nav-link[data-selected] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
    }

    .biz-item:hover {
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
  }

  .nav-link :global(.caret) {
    transition: transform 200ms var(--ease-out);
  }

  .nav-link[aria-expanded='true'] :global(.caret) {
    transform: rotate(180deg);
  }

  .biz {
    position: relative;
  }

  /* Origin-aware: the panel grows from its trigger. Opens in 200ms, closes faster. */
  .biz-panel {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: 50%;
    width: 22.5rem;
    margin-left: -11.25rem;
    padding: 0.5rem;
    border-radius: 22px;
    background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.62), rgb(255 255 255 / 0.46));
    box-shadow: var(--glass-thick), var(--glass-shadow-large);
    /* Materializes rather than fades: the frost comes in with the opacity and scale */
    -webkit-backdrop-filter: blur(0px) saturate(1) brightness(1);
    backdrop-filter: blur(0px) saturate(1) brightness(1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.96);
    transform-origin: 50% 0;
    transition:
      opacity 150ms ease,
      transform 150ms var(--ease-out),
      backdrop-filter 150ms ease,
      -webkit-backdrop-filter 150ms ease,
      visibility 150ms;
  }

  .biz-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1rem;
    height: 1rem;
  }

  .biz-panel[data-open] {
    -webkit-backdrop-filter: var(--glass-blur-large);
    backdrop-filter: var(--glass-blur-large);
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-duration: 220ms;
  }

  .biz-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 14px;
    transition: background-color 150ms ease;
  }

  .biz-item b {
    display: block;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .biz-item small {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .biz-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    corner-shape: squircle;
    background: color-mix(in srgb, var(--c) 14%, var(--page));
    color: var(--ci);
  }

  /* The menu button sits on the glass bar, so it is a plain symbol with a fill when
     pressed or open (never glass on glass) */
  .burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border-radius: 999px;
    transition:
      background-color 150ms ease,
      transform var(--glass-flex);
    -webkit-tap-highlight-color: transparent;
  }

  .burger:active,
  .burger[aria-expanded='true'] {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .burger:active {
    transform: scale(1.06);
  }

  .burger :global(.burger-close),
  .burger[aria-expanded='true'] :global(.burger-open) {
    display: none;
  }

  .burger[aria-expanded='true'] :global(.burger-close) {
    display: block;
  }

  .sheet {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .pill {
      width: 100%;
      max-width: 34rem;
      padding-right: 0.4375rem;
    }

    .nav-links {
      display: none;
    }

    .burger {
      display: grid;
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 0.5rem);
      display: flex;
      flex-direction: column;
      padding: 0.5rem;
      border-radius: 28px;
      background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.66), rgb(255 255 255 / 0.5));
      box-shadow: var(--glass-thick), var(--glass-shadow-large);
      -webkit-backdrop-filter: blur(0px) saturate(1) brightness(1);
      backdrop-filter: blur(0px) saturate(1) brightness(1);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px) scale(0.97);
      transform-origin: top center;
      transition:
        opacity 150ms ease,
        transform 150ms var(--ease-out),
        backdrop-filter 150ms ease,
        -webkit-backdrop-filter 150ms ease,
        visibility 150ms;
    }

    .sheet[data-open] {
      -webkit-backdrop-filter: var(--glass-blur-large);
      backdrop-filter: var(--glass-blur-large);
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-duration: 240ms;
    }

    .sheet-k {
      padding: 0.75rem 0.75rem 0.25rem;
    }

    .sheet a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.8rem 0.875rem;
      border-radius: 20px;
      font-size: 0.9375rem;
    }

    .sheet a small {
      font-size: 0.78rem;
      color: var(--muted);
      text-align: right;
    }

    .sheet hr {
      width: calc(100% - 1.5rem);
      margin: 0.25rem auto;
      border: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .burger {
      transition: none;
    }

    .burger:active {
      transform: none;
    }
  }

  /* Reduce Transparency: the glass turns frostier and hides more of what is behind */
  @media (prefers-reduced-transparency: reduce) {
    .pill::before,
    .biz-panel,
    .sheet {
      background: var(--paper);
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }

    .pill::after,
    .biz-panel::after,
    .sheet::after {
      background: var(--rule);
    }

    .nav::before {
      display: none;
    }
  }

  /* Increase Contrast: near-solid glass with a defined, contrasting border */
  @media (prefers-contrast: more) {
    .pill::before,
    .biz-panel,
    .sheet {
      background: var(--paper);
    }

    .pill::after,
    .biz-panel::after,
    .sheet::after {
      background: var(--ink);
    }

    .nav-glass {
      background: color-mix(in srgb, var(--ink) 14%, transparent);
    }
  }
</style>
