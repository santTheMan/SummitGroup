---
/**
 * Header: a floating pill centred at the top of the screen, holding the logo,
 * the "Our businesses" fold-out and the section links (no booking button: the
 * page's own calls to action carry that). A Liquid Glass capsule over the
 * page; on small screens it keeps the logo and a menu button, and the sheet
 * opens beneath it. The sheet carries no booking button either (Daniel removed
 * it on 24 Nov 2026): it holds only the businesses and the section links.
 * Selection (26 Nov 2026, Daniel's pick): Nimbus UI's "Waterline" liquid navbar
 * by Guglielmo Giannattasio (MIT), ported in src/scripts/liquid-nav.ts. A drop of
 * water marks the section you are reading; it stretches to the next one, splits
 * into droplets on long jumps and merges back with a ripple. The cursor lifts a
 * meniscus, a tap sends a wave along the bar, and each link's icon plays a small
 * scene when clicked (Our businesses: the door lights; How we work: a pop; Who we
 * work with: the globe spins; FAQ: a wiggle). Without WebGL a CSS drop stands in.
 * Material (23 Nov 2026, to Apple's Liquid Glass guidance): the header is the
 * navigation layer, so it is the glass. The bar, the "Our businesses" fold-out
 * and the small-screen sheet are Regular glass (tokens.css --glass-*); the
 * menus materialize as they open. What sits on the bar (the selection, the menu
 * button) uses fills, never glass on glass, and the selection lifts into a glass
 * lens only while pressed. A scroll edge effect softens content passing under it.
 * Emil's details: the fold-out grows from its trigger and closes faster than it
 * opens, links and buttons press in, hover effects only on devices that hover.
 * Behaviour: src/scripts/ui.ts.
 */
import lockup from '../assets/brand/SGI-lockup-colour.svg';
import { brand, businesses, navigation } from '../content/site.ts';
import Icon from './Icon.astro';

const lockupHeight = 22;
const lockupWidth = Math.round((lockup.width / lockup.height) * lockupHeight);
const icons = { institute: 'institute', sales: 'sales', pathways: 'pathways' } as const;

/* The links' icons (18px line icons in Nimbus's style) and the scene each plays when tapped */
const linkIcon: Record<string, { fx: 'glow' | 'pop' | 'spin' | 'wave'; d: string }> = {
  businesses: {
    fx: 'glow',
    d: '<rect x="5" y="3.5" width="14" height="17" rx="1.6"/><path d="M9 7.5h1.5M13.5 7.5H15M9 11h1.5M13.5 11H15"/><path class="nv-door" d="M10.25 20.5v-4h3.5v4Z"/>',
  },
  'how-we-work': { fx: 'pop', d: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8.2 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.8"/>' },
  'who-we-work-with': {
    fx: 'spin',
    d: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 2.6 14.6 0 17M12 3.5c-2.6 2.4-2.6 14.6 0 17"/>',
  },
  faq: { fx: 'wave', d: '<circle cx="12" cy="12" r="8.5"/><path d="M9.7 9.6a2.4 2.4 0 1 1 3.3 2.2c-.6.3-1 .8-1 1.5v.5"/><path d="M12 16.7h.01"/>' },
};
const ico = (id: string) => linkIcon[id];
---

<header class="nav" data-nav>
  <div class="pill">
    <canvas class="nav-water" aria-hidden="true" data-nav-water></canvas>
    <span class="nav-drop" aria-hidden="true" data-nav-drop></span>
    <a class="nav-brand" href="#top" aria-label={`${brand.name}, back to top`}>
      <img src={lockup.src} width={lockupWidth} height={lockupHeight} alt={brand.name} />
    </a>

    <nav class="nav-links" aria-label="Main" data-nav-links>
      <div class="biz" data-biz-menu>
        <button
          class="nav-link"
          type="button"
          aria-expanded="false"
          aria-controls="biz-panel"
          data-biz-trigger
          data-nav-item="businesses"
          data-fx={ico('businesses')?.fx}
        >
          <span class="nv-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ico('businesses')?.d} />
          </span>
          {navigation.businessesLabel}
          <Icon name="chevron" size={16} class="caret" />
        </button>
        <div class="biz-panel" id="biz-panel" data-biz-panel>
          <ul>
            {
              businesses.map((b) => (
                <li>
                  <a class="biz-item" href={`#business-${b.id}`} style={`--c: var(--c-${b.id}); --ci: var(--c-${b.id}-ink)`}>
                    <span class="biz-ic">
                      <Icon name={icons[b.id]} />
                    </span>
                    <span>
                      <b>{b.name}</b>
                      <small>{b.role}</small>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      {
        navigation.links.map((link) => (
          <a class="nav-link" href={link.href} data-nav-item={link.href.slice(1)} data-fx={ico(link.href.slice(1))?.fx}>
            <span class="nv-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ico(link.href.slice(1))?.d} />
            </span>
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-sheet"
      aria-label={navigation.menuLabel}
      data-burger
    >
      <Icon name="menu" class="burger-open" />
      <Icon name="close" class="burger-close" />
    </button>

    <nav class="sheet" id="nav-sheet" aria-label="Site menu" data-sheet>
      <p class="k sheet-k">{navigation.businessesLabel}</p>
      {
        businesses.map((b) => (
          <a href={`#business-${b.id}`}>
            {b.name}
            <small>{b.role}</small>
          </a>
        ))
      }
      <hr />
      {
        navigation.links.map((link) => (
          <a href={link.href}>
            {link.label}
            <Icon name="arrow" size={16} />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* The bar spans the page but is invisible; only the centred pill takes clicks. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0.75rem var(--gutter) 0;
    pointer-events: none;
  }

  /* Scroll edge effect (Apple's alternative to a hard divider): once the page has
     scrolled, content passing under the header softly blurs and fades into the page
     colour, so the glass bar always floats over a calm ground. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 5.5rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--page) 70%, transparent), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent);
    mask-image: linear-gradient(180deg, #000 35%, transparent);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .nav[data-scrolled]::before {
    opacity: 1;
  }

  /* The bar: transparent frosted glass (Daniel, 23 Nov 2026), the navigation layer
     floating over the page. Nearly clear, so the page shows through, heavily frosted
     so the links stay easy to read (the scroll edge effect softens what passes
     under it); a specular rim catches
     the light (brightest at the top, and following the pointer on desktop, set by
     ui.ts); a soft inner shade gives it thickness. Its shadow deepens once it floats
     over content. The glass lives on a layer under the bar (::before), not on the
     bar itself: an element with its own backdrop-filter becomes the "backdrop root"
     of everything inside it, and the fold-out and the phone menu would then blur
     only the bar, not the page behind them. */
  .pill {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 3.5rem;
    padding: 0 0.5rem 0 1.125rem;
    border-radius: 999px;
    box-shadow:
      0 0 0 0.5px rgb(7 27 52 / 0.06),
      0 8px 24px -16px rgb(7 27 52 / 0.28);
    pointer-events: auto;
    transition: box-shadow 300ms ease;
  }

  .pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-sheen), var(--glass-clear);
    box-shadow: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur-clear);
    backdrop-filter: var(--refract,) var(--glass-blur-clear);
    pointer-events: none;
  }

  .nav[data-scrolled] .pill {
    box-shadow:
      0 0 0 0.5px rgb(7 27 52 / 0.08),
      0 16px 40px -18px rgb(7 27 52 / 0.42);
  }

  .nav-brand {
    display: inline-flex;
    flex: none;
    margin-right: 1rem;
    border-radius: 6px;
  }

  .nav-brand img {
    height: 22px;
    width: auto;
  }

  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  /*
   * The water (liquid-nav.ts): a canvas over the bar's glass and under its content,
   * bleeding 14px past the pill for the drop's shadow and the ripples. Drawn in WebGL;
   * without it, a CSS drop (Nimbus's fallback) slides under the current link.
   */
  .nav-water {
    position: absolute;
    left: -14px;
    top: -14px;
    z-index: 0;
    pointer-events: none;
  }

  .pill[data-water='css'] .nav-water {
    display: none;
  }

  .nav-drop {
    display: none;
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    z-index: 0;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    will-change: transform, width;
    background:
      radial-gradient(120% 140% at 30% 0%, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0) 55%),
      rgb(255 255 255 / 0.38);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.95),
      inset 0 -2px 6px rgb(0 162 255 / 0.22),
      inset 0 0 0 1px rgb(255 255 255 / 0.55),
      0 6px 16px -6px rgb(0 70 140 / 0.45);
  }

  .pill[data-water='css'] .nav-drop {
    display: block;
  }

  /* Content sits on the water */
  .nav-brand,
  .nav-links,
  .burger {
    position: relative;
    z-index: 1;
  }
  /* The lit rim: a 1px ring of light, brightest where it meets the light (and, on the
     bar, leaning toward the pointer). A masked ring, so the gradient never washes
     over the glass inside it. It doubles as the hairline border under Reduce
     Transparency and Increase Contrast. */
  .pill::after,
  .biz-panel::after,
  .sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: var(--glass-rim);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .nav-links > * {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--ink) 86%, transparent);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform var(--press) var(--ease-out);
  }

  .nav-link:active {
    transform: scale(0.97);
  }

  /* The glass lens is the highlight; the selected link's text goes full ink */
  .nav-link[aria-expanded='true'],
  .nav-link[data-selected] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
    }

    .biz-item:hover {
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
  }

  .nav-link :global(.caret) {
    transition: transform 200ms var(--ease-out);
  }

  .nav-link[aria-expanded='true'] :global(.caret) {
    transform: rotate(180deg);
  }

  .biz {
    position: relative;
  }

  /* Origin-aware: the panel grows from its trigger. Opens in 200ms, closes faster. */
  .biz-panel {
    position: absolute;
    top: calc(100% + 0.875rem);
    left: 50%;
    width: 22.5rem;
    margin-left: -11.25rem;
    padding: 0.5rem;
    border-radius: 22px;
    background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.62), rgb(255 255 255 / 0.46));
    box-shadow: var(--glass-thick), var(--glass-shadow-large);
    /* Materializes rather than fades: the frost comes in with the opacity and scale */
    -webkit-backdrop-filter: blur(0px) saturate(1) brightness(1);
    backdrop-filter: blur(0px) saturate(1) brightness(1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.96);
    transform-origin: 50% 0;
    transition:
      opacity 150ms ease,
      transform 150ms var(--ease-out),
      backdrop-filter 150ms ease,
      -webkit-backdrop-filter 150ms ease,
      visibility 150ms;
  }

  .biz-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1rem;
    height: 1rem;
  }

  .biz-panel[data-open] {
    -webkit-backdrop-filter: var(--glass-blur-large);
    backdrop-filter: var(--glass-blur-large);
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-duration: 220ms;
  }

  .biz-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 14px;
    transition: background-color 150ms ease;
  }

  .biz-item b {
    display: block;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .biz-item small {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .biz-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    corner-shape: squircle;
    background: color-mix(in srgb, var(--c) 14%, var(--page));
    color: var(--ci);
  }

  /* The menu button sits on the glass bar, so it is a plain symbol with a fill when
     pressed or open (never glass on glass) */
  .burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border-radius: 999px;
    transition:
      background-color 150ms ease,
      transform var(--glass-flex);
    -webkit-tap-highlight-color: transparent;
  }

  .burger:active,
  .burger[aria-expanded='true'] {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .burger:active {
    transform: scale(1.06);
  }

  .burger :global(.burger-close),
  .burger[aria-expanded='true'] :global(.burger-open) {
    display: none;
  }

  .burger[aria-expanded='true'] :global(.burger-close) {
    display: block;
  }

  .sheet {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .pill {
      width: 100%;
      max-width: 34rem;
      padding-right: 0.4375rem;
    }

    .nav-links {
      display: none;
    }

    .burger {
      display: grid;
    }

    /* Without JavaScript the menu button can't open anything: hide it (every
       section is on this one page, and the footer repeats the links) */
    :global(.no-js) .burger {
      display: none;
    }

    /* The logo link is a full 44px tap target, like the menu button */
    .nav-brand {
      align-items: center;
      min-height: 2.75rem;
    }

    /* QA, 24 Nov: on a phone held sideways the sheet is taller than the screen, so it
       scrolls inside itself (and never scrolls the page behind it) */
    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 0.5rem);
      display: flex;
      flex-direction: column;
      max-height: calc(100dvh - var(--nav-h) - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.5rem;
      border-radius: 28px;
      background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.66), rgb(255 255 255 / 0.5));
      box-shadow: var(--glass-thick), var(--glass-shadow-large);
      -webkit-backdrop-filter: blur(0px) saturate(1) brightness(1);
      backdrop-filter: blur(0px) saturate(1) brightness(1);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px) scale(0.97);
      transform-origin: top center;
      transition:
        opacity 150ms ease,
        transform 150ms var(--ease-out),
        backdrop-filter 150ms ease,
        -webkit-backdrop-filter 150ms ease,
        visibility 150ms;
    }

    .sheet[data-open] {
      -webkit-backdrop-filter: var(--glass-blur-large);
      backdrop-filter: var(--glass-blur-large);
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-duration: 240ms;
    }

    .sheet-k {
      padding: 0.75rem 0.75rem 0.25rem;
    }

    .sheet a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.8rem 0.875rem;
      border-radius: 20px;
      font-size: 0.9375rem;
    }

    .sheet a small {
      font-size: 0.78rem;
      color: var(--muted);
      text-align: right;
    }

    .sheet hr {
      width: calc(100% - 1.5rem);
      margin: 0.25rem auto;
      border: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .burger {
      transition: none;
    }

    .burger:active {
      transform: none;
    }
  }

  /* Reduce Transparency: the glass turns frostier and hides more of what is behind */
  @media (prefers-reduced-transparency: reduce) {
    .pill::before,
    .biz-panel,
    .sheet {
      background: var(--paper);
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }

    .pill::after,
    .biz-panel::after,
    .sheet::after {
      background: var(--rule);
    }

    .nav::before {
      display: none;
    }
  }

  /* Increase Contrast: near-solid glass with a defined, contrasting border */
  @media (prefers-contrast: more) {
    .pill::before,
    .biz-panel,
    .sheet {
      background: var(--paper);
    }

    .pill::after,
    .biz-panel::after,
    .sheet::after {
      background: var(--ink);
    }

  }

  /* The icons and their scenes (Nimbus's keyframes). The current link's icon lifts a
     little; a tapped one plays its scene once (liquid-nav.ts sets data-fx). */
  .nv-ico {
    position: relative;
    display: inline-flex;
    flex: none;
  }

  .nv-ico svg {
    transition: transform 450ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .nav-link[data-selected] .nv-ico svg {
    transform: translateY(-1px) scale(1.08);
  }

  .nv-ico :global(.nv-door) {
    fill: transparent;
  }

  .nv-ico[data-fx='pop'] svg {
    animation: nv-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }

  .nv-ico[data-fx='spin'] svg {
    animation: nv-spin 1s cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .nv-ico[data-fx='glow'] svg {
    animation: nv-hop 0.8s cubic-bezier(0.3, 1.4, 0.5, 1) both;
    transform-origin: 50% 100%;
  }

  .nv-ico[data-fx='glow'] :global(.nv-door) {
    animation: nv-door 1.3s ease both;
  }

  .nv-ico[data-fx='wave'] svg {
    animation: nv-wave 0.9s ease-in-out both;
    transform-origin: 50% 92%;
  }

  @keyframes nv-pop {
    0% {
      transform: scale(0.72);
    }

    60% {
      transform: scale(1.2);
    }

    100% {
      transform: translateY(-1px) scale(1.08);
    }
  }

  @keyframes nv-spin {
    0% {
      transform: perspective(80px) rotateY(0);
    }

    100% {
      transform: perspective(80px) rotateY(360deg) translateY(-1px) scale(1.08);
    }
  }

  @keyframes nv-hop {
    0% {
      transform: none;
    }

    30% {
      transform: translateY(-5px) scale(1.04, 0.96);
    }

    55% {
      transform: translateY(0) scale(1.12, 0.88);
    }

    75% {
      transform: translateY(-2px) scale(0.98, 1.04);
    }

    100% {
      transform: translateY(-1px) scale(1.08);
    }
  }

  /* The door lights up: warm light, then the brand sky */
  @keyframes nv-door {
    0% {
      fill: transparent;
    }

    30% {
      fill: #fff3a8;
    }

    100% {
      fill: color-mix(in srgb, var(--sgi-sky) 60%, transparent);
    }
  }

  @keyframes nv-wave {
    0% {
      transform: none;
    }

    20% {
      transform: rotate(-15deg);
    }

    40% {
      transform: rotate(12deg);
    }

    60% {
      transform: rotate(-8deg);
    }

    80% {
      transform: rotate(4deg);
    }

    100% {
      transform: translateY(-1px) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-ico svg,
    .nv-ico :global(.nv-door) {
      animation: none !important;
      transition: none;
    }
  }
</style>
