---
import { about } from '../content/site.ts';
import { publishedProof } from '../lib/release.ts';

// Only approved proof points render; pending ones (for example the $1.5m
// client result) stay unpublished until their wording is verified.
const points = publishedProof();
---

<section class="section section--light about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__intro">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 class="section-heading" id="about-title">{about.heading}</h2>
      <p class="section-lead">{about.body}</p>
    </div>

    <ul role="list" class="stats" aria-label={about.proofLabel}>
      {
        points.map((point) => (
          <li class="stat">
            <span class="stat__value">{point.value}</span> <span class="stat__label">{point.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Subgrid keeps every label aligned to the widest number. */
  .stats {
    display: grid;
    grid-template-columns: auto 1fr;
    border-bottom: 1px solid var(--hairline-on-light);
  }

  .stat {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    column-gap: clamp(1.25rem, 3vw, 2.25rem);
    padding-block: clamp(1.1rem, 2.4vw, 1.6rem);
    border-top: 1px solid var(--hairline-on-light);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: var(--text-stat);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sgi-navy);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    max-width: 20rem;
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--text-on-light-muted);
  }

  @media (min-width: 60em) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
