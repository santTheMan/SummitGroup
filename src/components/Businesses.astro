---
/**
 * Teal Treasury's features block: a sticky stage that morphs between one scene
 * per business as each block of copy reaches the middle of the screen. There
 * is no panel behind the scenes: each floats straight over the page. On small
 * screens each block carries its own scene. Scene switching: src/scripts/ui.ts.
 */
import { businesses, businessesSection, illustrations } from '../content/site.ts';
import Scene from './Scene.astro';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="sec feats" id="businesses" aria-labelledby="businesses-title">
  <div class="wrap">
    <div class="split head" data-reveal>
      <p class="label">{businessesSection.eyebrow}</p>
      <div>
        <h2 class="h2" id="businesses-title">{businessesSection.heading}</h2>
        <p class="lead">{businessesSection.intro}</p>
      </div>
    </div>

    <div class="feat-grid">
      <div class="stage-col" aria-hidden="true">
        <div class="stage" data-stage data-scene="0" data-floats data-float-paused>
          {
            businesses.map((b, i) => (
              <div class="stage-layer" data-layer={i} data-on={i === 0 ? '' : undefined}>
                <Scene which={b.id} />
              </div>
            ))
          }
          <p class="stage-count">
            <b data-stage-n>01</b> / {pad(businesses.length)} · {illustrations.note}
          </p>
        </div>
      </div>

      <div class="feat-copy">
        {
          businesses.map((b, i) => (
            <article
              class="feat"
              id={`business-${b.id}`}
              data-feat={i}
              data-on={i === 0 ? '' : undefined}
              style={`--c: var(--c-${b.id}); --ci: var(--c-${b.id}-ink)`}
            >
              <div class="feat-inline" aria-hidden="true" data-on data-floats data-float-paused>
                <Scene which={b.id} />
              </div>
              <p class="feat-n">{pad(i + 1)}</p>
              <h3 class="feat-title">{b.name}</h3>
              <p class="feat-role">{b.role}</p>
              <p class="feat-text">{b.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 2rem;
  }

  .lead {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 5rem;
  }

  .stage-col {
    position: relative;
  }

  .stage {
    position: sticky;
    top: calc(50vh - 16.25rem + var(--nav-h) / 2);
    height: 32.5rem;
  }

  .stage-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.97);
    filter: blur(6px);
    transition:
      opacity 500ms ease,
      transform 700ms var(--ease-out),
      filter 500ms ease,
      visibility 500ms;
  }

  .stage-layer[data-on] {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
  }

  .stage-count {
    position: absolute;
    left: 1.125rem;
    bottom: 0.875rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .stage-count b {
    font-weight: 500;
    color: var(--accent-text);
  }

  .feat-copy {
    display: flex;
    flex-direction: column;
  }

  .feat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    min-height: 60vh;
    scroll-margin-top: 20vh;
  }

  /* The block beside the current scene is in ink; the others rest in the muted
     grey (still AA), rather than the template's low-opacity dimming. */
  .feat-n,
  .feat-title,
  .feat-role {
    color: var(--muted);
    transition: color 400ms ease;
  }

  .feat[data-on] .feat-title,
  .feat[data-on] .feat-role {
    color: var(--ink);
  }

  .feat[data-on] .feat-n {
    color: var(--ci);
  }

  .feat-n {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .feat-title {
    font-size: clamp(1.375rem, 1rem + 1.2vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  .feat-role {
    font-weight: 500;
  }

  .feat-text {
    max-width: 26rem;
    color: var(--muted);
  }

  .feat-inline {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .feat-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .stage-col {
      display: none;
    }

    /* Review, 24 Nov: tighter, with the description close under its illustration */
    .feat {
      min-height: 0;
      gap: 0.5rem;
      padding: 0.5rem 0 2.5rem;
    }

    .feat .feat-title,
    .feat .feat-role {
      color: var(--ink);
    }

    .feat .feat-n {
      color: var(--ci);
    }

    .feat-inline {
      position: relative;
      display: block;
      height: 22rem;
      margin-bottom: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-layer {
      transform: none;
      filter: none;
    }
  }
</style>
