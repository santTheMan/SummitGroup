---
/**
 * "One relationship. Three specialists." The hero funnel resolves here:
 * the SGI icon is the single source, with a connector to each business.
 * Colour is a cue only; every business is named in text.
 */
import { Image } from 'astro:assets';
import iconColour from '../assets/brand/SGI-icon-colour-4K.png';
import { brand, businesses, businessesSection } from '../content/site.ts';

const iconHeight = 40;
const iconWidth = Math.round((iconColour.width / iconColour.height) * iconHeight);
---

<section class="section businesses" id="businesses" aria-labelledby="businesses-title">
  <div class="container">
    <header class="businesses__header">
      <p class="eyebrow">{businessesSection.eyebrow}</p>
      <h2 class="section-heading" id="businesses-title">{businessesSection.heading}</h2>
      <p class="section-lead">{businessesSection.intro}</p>
    </header>

    <div class="org">
      <div class="org__root">
        <Image
          src={iconColour}
          alt=""
          width={iconWidth}
          height={iconHeight}
          densities={[1, 2, 3]}
          loading="lazy"
          decoding="async"
          class="org__icon"
        />
        <p class="org__root-label">{brand.name}</p>
      </div>

      <div class="org__links" aria-hidden="true"><span></span></div>

      <ul role="list" class="org__businesses">
        {
          businesses.map((business) => (
            <li class="business" id={`business-${business.id}`} data-accent={business.accent}>
              <h3 class="business__name">{business.name}</h3>
              <p class="business__role">{business.role}</p>
              <p class="business__summary">{business.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="talent-note">
      <svg class="talent-note__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 9v5M10 6.25v.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <span>{businessesSection.talentNote}</span>
    </p>
  </div>
</section>

<style>
  .businesses {
    --gap: clamp(1rem, 2vw, 1.5rem);
    background: var(--sgi-white);
    border-top: 1px solid var(--hairline-on-light);
  }

  .businesses__header {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .businesses__header .section-heading,
  .businesses__header .section-lead {
    margin-inline: auto;
  }

  .org {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .org__root {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .org__root :global(.org__icon) {
    width: auto;
    height: 40px;
  }

  .org__root-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
  }

  /* Connectors: one stem from SGI that branches to each business. */
  .org__links {
    position: relative;
    height: 2.5rem;
    margin-top: 1rem;
  }

  .org__links::before,
  .org__links span {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    background: var(--sgi-navy);
    opacity: 0.28;
  }

  .org__links::before {
    top: 0;
    height: 100%;
  }

  .org__links span {
    display: none;
  }

  .org__businesses {
    display: grid;
    gap: var(--gap);
  }

  .business {
    --accent: var(--accent-sales);
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--surface-light);
    border: 1px solid var(--hairline-on-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .business[data-accent='deep'] {
    --accent: var(--accent-institute);
  }

  .business[data-accent='sky'] {
    --accent: var(--accent-pathways);
  }

  .business::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--accent);
  }

  .business__name {
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .business__role {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--sgi-navy);
  }

  .business__summary {
    margin-top: 0.75rem;
    color: var(--text-on-light-muted);
  }

  .talent-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 44rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 1rem 1.25rem;
    font-size: var(--text-sm);
    color: var(--text-on-light-muted);
    background: var(--surface-light);
    border-radius: var(--radius-md);
  }

  .talent-note__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.1rem;
    color: var(--sgi-electric);
  }

  @media (min-width: 48em) {
    .org__businesses {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .org__links {
      height: 3rem;
    }

    /* Stem down to a rounded bracket that drops into the outer cards. */
    .org__links::before {
      height: 50%;
    }

    .org__links::after {
      content: '';
      position: absolute;
      top: 50%;
      left: calc((100% - 2 * var(--gap)) / 6);
      right: calc((100% - 2 * var(--gap)) / 6);
      height: 50%;
      border: 1px solid var(--sgi-navy);
      border-bottom: 0;
      border-radius: 14px 14px 0 0;
      opacity: 0.28;
    }

    .org__links span {
      display: block;
      top: 50%;
      height: 50%;
    }
  }
</style>
