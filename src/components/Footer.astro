---
/**
 * Footer after both templates: brand and columns, a legal bar, and a giant
 * outlined wordmark that rises letter by letter. Motion: src/scripts/motion.ts.
 */
import lockup from '../assets/brand/SGI-lockup-colour.svg';
import { ctaHref } from '../config/env.ts';
import { brand, businesses, cta, footer } from '../content/site.ts';

const year = new Date().getFullYear();
const lockupHeight = 28;
const lockupWidth = Math.round((lockup.width / lockup.height) * lockupHeight);
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <img src={lockup.src} width={lockupWidth} height={lockupHeight} alt={brand.name} loading="lazy" />
        <p>{footer.summary}</p>
      </div>
      <nav class="foot-col" aria-labelledby="foot-biz">
        <p id="foot-biz">{footer.columns.businesses}</p>
        {businesses.map((b) => <a href={`#business-${b.id}`}>{b.name}</a>)}
      </nav>
      <nav class="foot-col" aria-labelledby="foot-group">
        <p id="foot-group">{footer.columns.group}</p>
        {footer.groupLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="foot-col">
        <p>{footer.columns.start}</p>
        <a href={ctaHref}>{cta.label}</a>
      </div>
    </div>

    <div class="foot-bar">
      <p>&copy; {year} {footer.copyrightHolder}</p>
    </div>
  </div>

  <p class="bigmark" aria-hidden="true" data-bigmark>
    {[...footer.wordmark].map((ch) => <span>{ch}</span>)}
  </p>
</footer>

<style>
  .foot {
    position: relative;
    padding-top: 5rem;
    border-top: 1px solid var(--rule);
    overflow: hidden;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .foot-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 22rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .foot-brand img {
    width: auto;
    height: 28px;
  }

  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--t-small);
  }

  .foot-col p {
    margin-bottom: 0.375rem;
    font-weight: 500;
  }

  .foot-col a {
    width: max-content;
    color: var(--muted);
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .foot-col a:hover {
      color: var(--ink);
    }
  }

  .foot-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding: 1.125rem 0;
    border-block: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .bigmark {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    padding-top: 0.06em;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(5rem, 22vw, 20rem);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 22%, transparent);
    user-select: none;
  }

  .bigmark span {
    display: inline-block;
    background: linear-gradient(180deg, color-mix(in srgb, var(--sgi-electric) 26%, transparent), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  @media (max-width: 56.25rem) {
    .foot-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .foot-brand {
      grid-column: 1 / -1;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 45rem) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
