---
import Logo from './Logo.astro';
import { ctaHref } from '../config/env.ts';
import { cta, footer, navigation } from '../content/site.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo height={28} loading="lazy" class="site-footer__logo" />
      <p class="site-footer__summary">{footer.summary}</p>
    </div>

    <nav class="site-footer__nav" id="footer-nav" aria-label="Footer">
      <ul role="list">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={ctaHref}>{cta.label}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>&copy; {year} {footer.copyrightHolder}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    color: var(--text-on-dark-muted);
    background: var(--sgi-navy);
    border-top: 1px solid var(--hairline-on-dark);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__brand :global(.site-footer__logo) {
    width: auto;
    height: 28px;
  }

  .site-footer__summary {
    max-width: 24rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .site-footer__nav ul {
    display: grid;
    gap: 0.25rem;
  }

  .site-footer__nav a {
    display: inline-block;
    padding-block: 0.45rem;
    font-size: var(--text-sm);
    color: var(--sgi-white);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-footer__base {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    font-size: var(--text-xs);
    border-top: 1px solid var(--hairline-on-dark);
  }

  @media (min-width: 48em) {
    .site-footer__grid {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__nav ul {
      grid-template-columns: repeat(2, auto);
      column-gap: 3rem;
    }
  }
</style>
