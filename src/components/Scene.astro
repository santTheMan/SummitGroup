---
/**
 * One illustrated scene per business, shown in the sticky stage on wide
 * screens and above each business on small ones. Decorative: the business
 * copy beside it carries the content, so scenes are aria-hidden.
 *
 * Redrawn 25 Nov 2026 (Daniel: "they look bad"). The three were unrelated
 * mini-dashboards with tiny type, fake buttons, chips adrift from their card, a
 * ghost stack behind one and a shadow puddle under each, all bobbing on a slow
 * loop. Now they are one set: the same card for every business (its name and a
 * label, a title, one visual in the business's colour, a few rows), type no
 * smaller than 12px, nothing that looks pressable, and no perpetual motion
 * (Apple's guidance: no slow looping oscillation). Each builds once as its scene
 * comes in: the modules fill, the bars rise, the steps tick, on a strong ease-out
 * with short, uneven staggers; with reduced motion they simply appear.
 *
 * Liquid glass (Daniel, 25 Nov: "change the colour, or maybe liquid glass"):
 * glass only reads with colour behind it, so each scene is lit by two soft
 * lights, its business's blue and one of the brand glows (peach or sky), and the
 * card is the site's own Liquid Glass (tokens.css: --glass-blur-large, sheen,
 * thick edge and the 1px lit rim the header uses). Colour stays on solid marks
 * (bars, segments, dots) on top of the glass; quiet text is darker inside the
 * card, so it reads over the colour. Reduce Transparency makes the card solid.
 *
 * Black glass (Daniel, 26 Nov, kept): the cards are now smoked black glass in the
 * language of the two components he sent, LiquidButton's dark mode for the card and
 * Nimbus "Waterline" water (dark tone) for the marks; see the block "Black glass" in
 * the styles below, which overrides the light glass above. Labels measure at least
 * 5:1 on desktop and phone.
 */
import { businesses, illustrations } from '../content/site.ts';
import Icon from './Icon.astro';

interface Props {
  which: 'institute' | 'sales' | 'pathways';
}

const { which } = Astro.props;
const s = illustrations.scenes;
const name = businesses.find((b) => b.id === which)?.name ?? '';
const maxBar = Math.max(...s.sales.chart);
// Uneven staggers read as one gesture rather than a metronome
const stagger = [0, 55, 100, 140, 175, 205];
const label = { institute: s.institute.label, sales: s.sales.label, pathways: s.pathways.label }[which];
const title = { institute: s.institute.title, sales: s.sales.title, pathways: s.pathways.title }[which];
---

<div class:list={['scene', `scene--${which}`]}>
  <span class="lights"></span>
  <div class="card">
    <p class="card-head">
      <span class="card-name"><i></i>{name}</span>
      <span class="card-label">{label}</span>
    </p>
    <p class="card-title">{title}</p>

    {
      which === 'institute' && (
        <div class="card-body">
          <p class="progress">
            <b>{s.institute.done}</b> of {s.institute.total} <span>{s.institute.progress}</span>
          </p>
          <span class="segs">
            {Array.from({ length: s.institute.total }, (_, i) => (
              <i data-done={i < s.institute.done ? '' : undefined} style={`--d:${stagger[i]}ms`} />
            ))}
          </span>
          <ul class="rows">
            {s.institute.modules.map((m, i) => (
              <li data-state={['done', 'now', 'next'][i]} style={`--d:${stagger[i + 2]}ms`}>
                <span class="row-n">{m.n}</span>
                <span class="row-name">{m.name}</span>
                <span class="row-state">
                  {i === 0 && <Icon name="check" size={14} />}
                  {m.state}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      which === 'sales' && (
        <div class="card-body">
          <dl class="stats">
            {s.sales.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
          <span class="bars">
            {s.sales.chart.map((v, i) => (
              <i
                style={`--h:${((v / maxBar) * 100).toFixed(1)}%; --d:${stagger[i]}ms`}
                data-last={i === s.sales.chart.length - 1 ? '' : undefined}
              />
            ))}
          </span>
          <p class="chart-k">{s.sales.chartLabel}</p>
        </div>
      )
    }

    {
      which === 'pathways' && (
        <div class="card-body">
          <ol class="steps">
            {s.pathways.steps.map((step, i) => (
              <li data-state={i < s.pathways.done ? 'done' : 'now'} style={`--d:${(stagger[i] ?? 0) * 2}ms`}>
                <span class="step-dot">{i < s.pathways.done && <Icon name="check" size={12} />}</span>
                {step}
              </li>
            ))}
          </ol>
          <p class="meter-row">
            <span class="meter" style={`--p:${s.pathways.done / s.pathways.steps.length}`}>
              <i />
            </span>
            {s.pathways.done} {s.pathways.progress}
          </p>
        </div>
      )
    }
  </div>
</div>

<style>
  .scene {
    --accent: var(--c-institute);
    --accent-soft: color-mix(in srgb, var(--accent) 12%, var(--paper));
    --rule-soft: color-mix(in srgb, var(--ink) 9%, transparent);
    --enter: cubic-bezier(0.23, 1, 0.32, 1);

    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  /* Each scene's two lights: its business's blue, and a brand glow opposite */
  .scene--institute {
    --light-a: color-mix(in srgb, var(--sgi-deep) 58%, transparent);
    --light-b: var(--glow-b);
  }

  .scene--sales {
    --accent: var(--c-sales);
    --light-a: color-mix(in srgb, var(--sgi-electric) 58%, transparent);
    --light-b: color-mix(in srgb, var(--sgi-sky) 80%, transparent);
  }

  /* Sky is too pale for marks on white: its ink shade carries them */
  .scene--pathways {
    --accent: var(--c-pathways-ink);
    --light-a: color-mix(in srgb, var(--sgi-sky) 90%, transparent);
    --light-b: var(--glow-b);
  }

  /* The lights: two soft pools behind the card (radial gradients, no blur filter,
     so Safari never repaints a box around them) */
  .lights {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Centred near the card's opposite corners, so each spills past the glass edge
     and shows through it */
  .lights::before,
  .lights::after {
    content: '';
    position: absolute;
    width: min(64%, 24rem);
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .lights::before {
    left: 2%;
    top: -2%;
    background: radial-gradient(closest-side, var(--light-a), transparent);
  }

  .lights::after {
    right: 0;
    bottom: -4%;
    background: radial-gradient(closest-side, var(--light-b), transparent);
  }

  /* Small screens: the card sits in the flow above its copy */
  :global(.feat-inline) > .scene {
    position: relative;
    inset: auto;
    display: block;
    padding: 0;
  }

  /* There, the light spills above and below the card, never past the page's sides */
  :global(.feat-inline) > .scene .lights {
    inset: -1.75rem 0;
  }

  :global(.feat-inline) > .scene .lights::before,
  :global(.feat-inline) > .scene .lights::after {
    width: 62%;
  }

  :global(.feat-inline) > .scene .lights::before {
    left: -6%;
  }

  :global(.feat-inline) > .scene .lights::after {
    right: -6%;
  }

  /* One card for all three, in Liquid Glass: the lights blur and brighten through
     a milky body, a sheen from the top, a thick edge and a lit 1px rim */
  .card {
    /* Quiet text a step darker than the page's --muted: it sits over colour here */
    --muted: color-mix(in srgb, var(--ink) 72%, transparent);

    position: relative;
    width: min(27rem, 100%);
    padding: 1.5rem 1.5rem 1.375rem;
    border-radius: 22px;
    background:
      var(--glass-sheen),
      linear-gradient(180deg, rgb(255 255 255 / 0.66), rgb(255 255 255 / 0.44));
    -webkit-backdrop-filter: var(--glass-blur-large);
    backdrop-filter: var(--refract,) var(--card-blur, var(--glass-blur-large));
    box-shadow:
      var(--glass-thick),
      var(--glass-shadow-large);
  }

  /* With refraction (refract.ts), the card's middle clears: half the frost, still
     enough for its text */
  :global([data-refract]) .card {
    --card-blur: blur(12px) saturate(1.9) brightness(1.05);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: var(--glass-rim);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .card-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--ink);
  }

  .card-name i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .card-label {
    color: var(--muted);
  }

  .card-title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--ink);
  }

  .card-body {
    margin-top: 1.25rem;
  }

  /* Institute: modules done, as a segmented bar, then the modules around "now" */
  .progress {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .progress b {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .progress span {
    margin-left: 0.25rem;
  }

  .segs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 0.625rem;
  }

  .segs i {
    height: 0.5rem;
    border-radius: 3px;
    background: var(--rule-soft);
    overflow: hidden;
  }

  /* A done segment fills from the left (its colour is a pseudo-element, so the
     track stays put while it grows) */
  .segs i[data-done] {
    position: relative;
  }

  .segs i[data-done]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transition: transform 420ms var(--enter) calc(var(--d) + 120ms);
  }

  .rows {
    margin-top: 1.125rem;
    border-top: 1px solid var(--rule-soft);
  }

  .rows li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 0.9375rem;
    transition:
      opacity 360ms var(--enter) calc(var(--d) + 200ms),
      translate 360ms var(--enter) calc(var(--d) + 200ms);
  }

  .rows li:last-child {
    border-bottom: 0;
  }

  .row-n {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .row-name {
    color: var(--ink);
  }

  .row-state {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .rows li[data-state='done'] .row-state {
    color: var(--accent);
  }

  .rows li[data-state='done'] .row-name {
    color: var(--muted);
  }

  .rows li[data-state='now'] .row-state {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  /* Sales: three figures, then six weeks of coaching sessions */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  /* The figure above its label (dt stays first in the markup); packed to the top,
     so the three figures share a line even when a label wraps */
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.125rem;
  }

  .stats dt {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    gap: 0.5rem;
    height: 5.5rem;
    margin-top: 1.25rem;
  }

  .bars i {
    height: var(--h);
    border-radius: 6px 6px 2px 2px;
    background: color-mix(in srgb, var(--accent) 22%, var(--paper));
    transform-origin: bottom;
    transition: transform 520ms var(--enter) calc(var(--d) + 120ms);
  }

  .bars i[data-last] {
    background: var(--accent);
  }

  .chart-k {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Pathways: the brief's four steps on one line of progress */
  .steps {
    position: relative;
    display: grid;
    gap: 0.875rem;
  }

  .steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  /* The thread between steps: in the accent between done steps */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.625rem - 1px);
    top: 1.25rem;
    height: calc(0.875rem + 0.25rem);
    width: 2px;
    border-radius: 1px;
    background: var(--rule-soft);
  }

  .steps li[data-state='done']:not(:nth-last-child(2))::after {
    background: var(--accent);
  }

  .step-dot {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    color: var(--paper);
    transition:
      transform 360ms var(--enter) calc(var(--d) + 150ms),
      opacity 360ms var(--enter) calc(var(--d) + 150ms);
  }

  .steps li[data-state='done'] .step-dot {
    background: var(--accent);
  }

  /* "Now": an open ring with a soft halo */
  .steps li[data-state='now'] .step-dot {
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .steps li[data-state='now'] {
    font-weight: 500;
  }

  .meter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-soft);
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .meter {
    flex: 1;
    height: 0.375rem;
    border-radius: 3px;
    background: var(--rule-soft);
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    width: calc(var(--p) * 100%);
    border-radius: 3px;
    background: var(--accent);
    transform-origin: left;
    transition: transform 700ms var(--enter) 380ms;
  }

  /* ---------- Black glass, in the language of Daniel's two components (26 Nov 2026) ----------
     The card is smoked black glass: LiquidButton's dark mode (21st.dev "liquid-glass-button":
     white crescents inside the rim, a faint white inner glow) over a deep navy-black body, its
     noise warp bending the lights behind where Chromium draws it. The marks are Nimbus water in
     its dark tone (the "Waterline" navbar: deeper water, a bright rim): coloured marks are water
     in a light shade of the business's blue (the brand's deep navy would vanish on black),
     empty ones clear water. Text is white, quiet text 68% white. */
  .scene {
    --ink-on: #f1f7ff;
    --quiet-on: rgb(241 247 255 / 0.68);
    --rule-on: rgb(255 255 255 / 0.12);
    --water-clear:
      radial-gradient(120% 140% at 30% 0%, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0) 55%),
      rgb(255 255 255 / 0.1);
    --water-clear-edge:
      inset 0 1px 1px rgb(255 255 255 / 0.5), inset 0 -2px 6px rgb(112 191 255 / 0.18),
      inset 0 0 0 1px rgb(255 255 255 / 0.16), 0 4px 10px -5px rgb(0 0 0 / 0.5);
    --water-tint:
      radial-gradient(120% 140% at 30% 0%, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0) 55%),
      var(--accent-on);
    --water-tint-edge:
      inset 0 1px 1px rgb(255 255 255 / 0.7), inset 0 -2px 5px rgb(0 20 60 / 0.35),
      inset 0 0 0 1px rgb(255 255 255 / 0.25), 0 5px 14px -5px color-mix(in srgb, var(--accent-on) 60%, transparent);
  }

  /* Each business's blue, lightened to read on black */
  .scene--institute {
    --accent-on: color-mix(in srgb, var(--sgi-deep) 14%, #b9d8f8);
  }

  .scene--sales {
    --accent-on: color-mix(in srgb, var(--sgi-electric) 72%, #ffffff);
  }

  .scene--pathways {
    --accent-on: var(--sgi-sky);
  }

  .card {
    --ink: var(--ink-on);
    --muted: var(--quiet-on);
    --rule-soft: var(--rule-on);

    background:
      radial-gradient(130% 90% at 30% -10%, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0) 60%),
      rgb(6 13 28 / 0.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    color: var(--ink-on);
    box-shadow:
      0 0 8px rgb(0 0 0 / 0.03),
      0 2px 6px rgb(0 0 0 / 0.08),
      inset 3px 3px 0.5px -3.5px rgb(255 255 255 / 0.09),
      inset -3px -3px 0.5px -3.5px rgb(255 255 255 / 0.85),
      inset 1px 1px 1px -0.5px rgb(255 255 255 / 0.6),
      inset -1px -1px 1px -0.5px rgb(255 255 255 / 0.6),
      inset 0 0 6px 6px rgb(255 255 255 / 0.12),
      inset 0 0 2px 2px rgb(255 255 255 / 0.06),
      0 0 12px rgb(0 0 0 / 0.15),
      0 30px 60px -28px rgb(7 27 52 / 0.55);
  }

  :global(html[data-refract]) .card {
    background:
      radial-gradient(130% 90% at 30% -10%, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0) 60%),
      rgb(6 13 28 / 0.76);
    backdrop-filter: url(#liquid-glass) saturate(1.6);
  }

  .card::after {
    display: none;
  }

  .card-name i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
  }

  .segs {
    gap: 0.3125rem;
  }

  .segs i {
    height: 0.625rem;
    border-radius: 999px;
    background: var(--water-clear);
    box-shadow: var(--water-clear-edge);
  }

  .segs i[data-done]::after {
    border-radius: inherit;
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
  }

  .rows li[data-state='done'] .row-state {
    color: var(--accent-on);
  }

  /* "In progress": a bead of the business's water with navy text, like the navbar's drop */
  .rows li[data-state='now'] .row-state {
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
    color: var(--sgi-navy);
  }

  .bars i {
    border-radius: 10px 10px 6px 6px;
    background: var(--water-clear);
    box-shadow: var(--water-clear-edge);
  }

  .bars i[data-last] {
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
  }

  .step-dot {
    border: 0;
    color: var(--sgi-navy);
    background: var(--water-clear);
    box-shadow:
      var(--water-clear-edge),
      inset 0 0 0 1.5px color-mix(in srgb, var(--accent-on) 75%, transparent);
  }

  .steps li[data-state='done'] .step-dot {
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
  }

  .steps li[data-state='now'] .step-dot {
    box-shadow:
      var(--water-clear-edge),
      inset 0 0 0 1.5px var(--accent-on),
      0 0 0 4px color-mix(in srgb, var(--accent-on) 22%, transparent);
  }

  .steps li[data-state='done']:not(:nth-last-child(2))::after {
    background: var(--accent-on);
  }

  .meter {
    height: 0.5rem;
    background: var(--water-clear);
    box-shadow: var(--water-clear-edge);
  }

  .meter i {
    background: var(--water-tint);
    box-shadow: var(--water-tint-edge);
  }

  /* Before a scene comes in (its stage layer is off): the build's starting point.
     The inline scenes on small screens are always on, so they rest finished. */
  :global(:not([data-on])) > .scene .segs i[data-done]::after,
  :global(:not([data-on])) > .scene .meter i {
    transform: scaleX(0);
  }

  :global(:not([data-on])) > .scene .bars i {
    transform: scaleY(0.12);
  }

  :global(:not([data-on])) > .scene .rows li {
    opacity: 0;
    translate: 0 6px;
  }

  :global(:not([data-on])) > .scene .step-dot {
    transform: scale(0.6);
    opacity: 0;
  }

  /* Leaving: reset in one step once the layer has faded out (500ms), so the next
     visit builds again and nothing drops while it is still visible */
  :global(:not([data-on])) > .scene *,
  :global(:not([data-on])) > .scene .segs i[data-done]::after {
    transition-duration: 0ms;
    transition-delay: 520ms;
  }

  @media (max-width: 30rem) {
    .card {
      padding: 1.25rem 1.125rem 1.125rem;
    }

    .card-title {
      margin-top: 1rem;
      font-size: 1.375rem;
    }

    .card-body {
      margin-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene *,
    .segs i[data-done]::after {
      transition: none !important;
    }
  }

  /* Reduce Transparency: solid black glass; Increase Contrast: solid, with a white edge */
  @media (prefers-reduced-transparency: reduce) {
    .card {
