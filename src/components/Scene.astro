---
/**
 * One illustrated scene per business, shown in the sticky stage on wide
 * screens and above each business on small ones. Decorative: the business
 * copy beside it carries the content, so scenes are aria-hidden.
 *
 * Redrawn 25 Nov 2026 (Daniel: "they look bad"). The three were unrelated
 * mini-dashboards with tiny type, fake buttons, chips adrift from their card, a
 * ghost stack behind one and a shadow puddle under each, all bobbing on a slow
 * loop. Now they are one set: the same card for every business (its name and a
 * label, a title, one visual in the business's colour, a few rows), type no
 * smaller than 12px, nothing that looks pressable, and no perpetual motion
 * (Apple's guidance: no slow looping oscillation). Each builds once as its scene
 * comes in: the modules fill, the bars rise, the steps tick, on a strong ease-out
 * with short, uneven staggers; with reduced motion they simply appear.
 */
import { businesses, illustrations } from '../content/site.ts';
import Icon from './Icon.astro';

interface Props {
  which: 'institute' | 'sales' | 'pathways';
}

const { which } = Astro.props;
const s = illustrations.scenes;
const name = businesses.find((b) => b.id === which)?.name ?? '';
const maxBar = Math.max(...s.sales.chart);
// Uneven staggers read as one gesture rather than a metronome
const stagger = [0, 55, 100, 140, 175, 205];
const label = { institute: s.institute.label, sales: s.sales.label, pathways: s.pathways.label }[which];
const title = { institute: s.institute.title, sales: s.sales.title, pathways: s.pathways.title }[which];
---

<div class:list={['scene', `scene--${which}`]}>
  <div class="card">
    <p class="card-head">
      <span class="card-name"><i></i>{name}</span>
      <span class="card-label">{label}</span>
    </p>
    <p class="card-title">{title}</p>

    {
      which === 'institute' && (
        <div class="card-body">
          <p class="progress">
            <b>{s.institute.done}</b> of {s.institute.total} <span>{s.institute.progress}</span>
          </p>
          <span class="segs">
            {Array.from({ length: s.institute.total }, (_, i) => (
              <i data-done={i < s.institute.done ? '' : undefined} style={`--d:${stagger[i]}ms`} />
            ))}
          </span>
          <ul class="rows">
            {s.institute.modules.map((m, i) => (
              <li data-state={['done', 'now', 'next'][i]} style={`--d:${stagger[i + 2]}ms`}>
                <span class="row-n">{m.n}</span>
                <span class="row-name">{m.name}</span>
                <span class="row-state">
                  {i === 0 && <Icon name="check" size={14} />}
                  {m.state}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      which === 'sales' && (
        <div class="card-body">
          <dl class="stats">
            {s.sales.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
          <span class="bars">
            {s.sales.chart.map((v, i) => (
              <i
                style={`--h:${((v / maxBar) * 100).toFixed(1)}%; --d:${stagger[i]}ms`}
                data-last={i === s.sales.chart.length - 1 ? '' : undefined}
              />
            ))}
          </span>
          <p class="chart-k">{s.sales.chartLabel}</p>
        </div>
      )
    }

    {
      which === 'pathways' && (
        <div class="card-body">
          <ol class="steps">
            {s.pathways.steps.map((step, i) => (
              <li data-state={i < s.pathways.done ? 'done' : 'now'} style={`--d:${(stagger[i] ?? 0) * 2}ms`}>
                <span class="step-dot">{i < s.pathways.done && <Icon name="check" size={12} />}</span>
                {step}
              </li>
            ))}
          </ol>
          <p class="meter-row">
            <span class="meter" style={`--p:${s.pathways.done / s.pathways.steps.length}`}>
              <i />
            </span>
            {s.pathways.done} {s.pathways.progress}
          </p>
        </div>
      )
    }
  </div>
</div>

<style>
  .scene {
    --accent: var(--c-institute);
    --accent-soft: color-mix(in srgb, var(--accent) 12%, var(--paper));
    --rule-soft: color-mix(in srgb, var(--ink) 9%, transparent);
    --enter: cubic-bezier(0.23, 1, 0.32, 1);

    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .scene--sales {
    --accent: var(--c-sales);
  }

  /* Sky is too pale for marks on white: its ink shade carries them */
  .scene--pathways {
    --accent: var(--c-pathways-ink);
  }

  /* Small screens: the card sits in the flow above its copy */
  :global(.feat-inline) > .scene {
    position: relative;
    inset: auto;
    display: block;
    padding: 0;
  }

  /* One card for all three: paper, a hairline, a soft layered shadow (no puddle) */
  .card {
    width: min(27rem, 100%);
    padding: 1.5rem 1.5rem 1.375rem;
    border-radius: 20px;
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    box-shadow:
      0 1px 2px rgb(7 27 52 / 0.04),
      0 4px 10px -4px rgb(7 27 52 / 0.06),
      0 28px 56px -28px rgb(7 27 52 / 0.24);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .card-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--ink);
  }

  .card-name i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .card-label {
    color: var(--muted);
  }

  .card-title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--ink);
  }

  .card-body {
    margin-top: 1.25rem;
  }

  /* Institute: modules done, as a segmented bar, then the modules around "now" */
  .progress {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .progress b {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .progress span {
    margin-left: 0.25rem;
  }

  .segs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 0.625rem;
  }

  .segs i {
    height: 0.5rem;
    border-radius: 3px;
    background: var(--rule-soft);
    overflow: hidden;
  }

  /* A done segment fills from the left (its colour is a pseudo-element, so the
     track stays put while it grows) */
  .segs i[data-done] {
    position: relative;
  }

  .segs i[data-done]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transition: transform 420ms var(--enter) calc(var(--d) + 120ms);
  }

  .rows {
    margin-top: 1.125rem;
    border-top: 1px solid var(--rule-soft);
  }

  .rows li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 0.9375rem;
    transition:
      opacity 360ms var(--enter) calc(var(--d) + 200ms),
      translate 360ms var(--enter) calc(var(--d) + 200ms);
  }

  .rows li:last-child {
    border-bottom: 0;
  }

  .row-n {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .row-name {
    color: var(--ink);
  }

  .row-state {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .rows li[data-state='done'] .row-state {
    color: var(--accent);
  }

  .rows li[data-state='done'] .row-name {
    color: var(--muted);
  }

  .rows li[data-state='now'] .row-state {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  /* Sales: three figures, then six weeks of coaching sessions */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  /* The figure above its label (dt stays first in the markup); packed to the top,
     so the three figures share a line even when a label wraps */
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.125rem;
  }

  .stats dt {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    gap: 0.5rem;
    height: 5.5rem;
    margin-top: 1.25rem;
  }

  .bars i {
    height: var(--h);
    border-radius: 6px 6px 2px 2px;
    background: color-mix(in srgb, var(--accent) 22%, var(--paper));
    transform-origin: bottom;
    transition: transform 520ms var(--enter) calc(var(--d) + 120ms);
  }

  .bars i[data-last] {
    background: var(--accent);
  }

  .chart-k {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Pathways: the brief's four steps on one line of progress */
  .steps {
    position: relative;
    display: grid;
    gap: 0.875rem;
  }

  .steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  /* The thread between steps: in the accent between done steps */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.625rem - 1px);
    top: 1.25rem;
    height: calc(0.875rem + 0.25rem);
    width: 2px;
    border-radius: 1px;
    background: var(--rule-soft);
  }

  .steps li[data-state='done']:not(:nth-last-child(2))::after {
    background: var(--accent);
  }

  .step-dot {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    color: var(--paper);
    transition:
      transform 360ms var(--enter) calc(var(--d) + 150ms),
      opacity 360ms var(--enter) calc(var(--d) + 150ms);
  }

  .steps li[data-state='done'] .step-dot {
    background: var(--accent);
  }

  /* "Now": an open ring with a soft halo */
  .steps li[data-state='now'] .step-dot {
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .steps li[data-state='now'] {
    font-weight: 500;
  }

  .meter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-soft);
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .meter {
    flex: 1;
    height: 0.375rem;
    border-radius: 3px;
    background: var(--rule-soft);
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    width: calc(var(--p) * 100%);
    border-radius: 3px;
    background: var(--accent);
    transform-origin: left;
    transition: transform 700ms var(--enter) 380ms;
  }

  /* Before a scene comes in (its stage layer is off): the build's starting point.
     The inline scenes on small screens are always on, so they rest finished. */
  :global(:not([data-on])) > .scene .segs i[data-done]::after,
  :global(:not([data-on])) > .scene .meter i {
    transform: scaleX(0);
  }

  :global(:not([data-on])) > .scene .bars i {
    transform: scaleY(0.12);
  }

  :global(:not([data-on])) > .scene .rows li {
    opacity: 0;
    translate: 0 6px;
  }

  :global(:not([data-on])) > .scene .step-dot {
    transform: scale(0.6);
    opacity: 0;
  }

  /* Leaving: reset in one step once the layer has faded out (500ms), so the next
     visit builds again and nothing drops while it is still visible */
  :global(:not([data-on])) > .scene *,
  :global(:not([data-on])) > .scene .segs i[data-done]::after {
    transition-duration: 0ms;
    transition-delay: 520ms;
  }

  @media (max-width: 30rem) {
    .card {
      padding: 1.25rem 1.125rem 1.125rem;
    }

    .card-title {
      margin-top: 1rem;
      font-size: 1.375rem;
    }

    .card-body {
      margin-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene *,
    .segs i[data-done]::after {
      transition: none !important;
    }
  }
</style>
