---
import CtaButton from './CtaButton.astro';
import { businesses, hero } from '../content/site.ts';
---

<section class="hero on-dark" id="top" aria-labelledby="hero-title" data-funnel>
  <div class="hero__media" aria-hidden="true">
    <canvas class="hero__canvas" data-funnel-canvas></canvas>
  </div>

  <div class="hero__body container">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{hero.headline}</h1>
      <p class="hero__support">{hero.support}</p>
      <div class="hero__action">
        <CtaButton size="large" funnelWaist />
      </div>
    </div>
  </div>

  <div class="hero__destinations container">
    <ul role="list" class="destinations" aria-label={hero.destinationsLabel}>
      {
        businesses.map((business) => (
          <li class="destination">
            <a class="destination__link" href={`#business-${business.id}`}>
              <span class="destination__node" data-funnel-node aria-hidden="true" />
              <span class="destination__name">{business.name}</span>
              <span class="destination__role">{business.role}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { mountFunnel } from '../scripts/funnel/index.ts';
  const hero = document.querySelector<HTMLElement>('[data-funnel]');
  if (hero) mountFunnel(hero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: max(100svh, 40rem);
    padding-top: var(--header-height);
    overflow: hidden;
    color: var(--text-on-dark);
    /* Still fallback (no JavaScript): a soft glow where the funnel narrows. */
    background:
      radial-gradient(ellipse 34% 30% at 50% 66%, rgb(34 100 210 / 0.18), transparent 72%),
      var(--sgi-navy);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  :global(.funnel-ready) .hero__canvas {
    opacity: 1;
  }

  /* Edge and lower veils keep the motif calm under the header and at the sides. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--sgi-navy) 0, rgb(7 27 52 / 0) 24%),
      linear-gradient(to right, var(--sgi-navy) 0, rgb(7 27 52 / 0) 16%, rgb(7 27 52 / 0) 84%, var(--sgi-navy) 100%),
      linear-gradient(to top, var(--sgi-navy) 0, rgb(7 27 52 / 0) 9%);
  }

  .hero__body {
    align-self: center;
    padding-block: clamp(2.5rem, 8vh, 6rem) clamp(5.5rem, 17vh, 11rem);
  }

  .hero__copy {
    position: relative;
    max-width: 60rem;
    margin-inline: auto;
    text-align: center;
  }

  /* Legibility scrim: dims the filaments directly behind the words. */
  .hero__copy::before {
    content: '';
    position: absolute;
    inset: -14% -10% -4%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(7 27 52 / 0.82), rgb(7 27 52 / 0.55) 55%, rgb(7 27 52 / 0));
    pointer-events: none;
  }

  .hero__title {
    max-width: 17em;
    margin-inline: auto;
    font-size: var(--text-hero);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--sgi-white);
  }

  .hero__support {
    max-width: 30rem;
    margin: 1.4rem auto 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text-on-dark-muted);
  }

  .hero__action {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }

  .hero__action :global(.button) {
    box-shadow:
      0 0 0 6px rgb(7 27 52 / 0.85),
      0 1px 0 rgb(255 255 255 / 0.18) inset,
      0 16px 40px -10px rgb(34 100 210 / 0.8);
  }

  .hero__destinations {
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }

  .destinations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 58rem;
    margin-inline: auto;
    border-top: 1px solid var(--hairline-on-dark);
  }

  .destination__link {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding: 1.35rem 0.4rem 0.35rem;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .destination__node {
    position: absolute;
    top: 0;
    left: 50%;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    background: var(--sgi-navy);
    border: 1px solid rgb(243 248 255 / 0.85);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgb(7 27 52 / 0.9);
  }

  .destination__name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.86rem + 0.35vw, 1.125rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--sgi-white);
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .destination__role {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--text-on-dark-muted);
  }

  .destination__link:hover .destination__name {
    text-decoration: underline;
  }

  /* Very small screens: names only, roles stay available to screen readers. */
  @media (max-width: 29.99em) {
    .destination__role {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__canvas {
      transition: none;
    }
  }
</style>
