---
/**
 * Hero after Teal Treasury: the approved promise rises out of line masks,
 * then the working panel stands up from a tilt as it scrolls into view. The
 * panel stands alone: Daniel removed both floating cards ("New brief" and
 * "Update from SGI") on 22 Nov 2026 because they pulled focus from it.
 * Motion: src/scripts/motion.ts.
 */
import { hero } from '../content/site.ts';
import BriefPanel from './BriefPanel.astro';
import CtaButton from './CtaButton.astro';

const headlineWords = hero.headline.split(' ');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-head">
    <h1 class="h1" id="hero-title">
      {
        headlineWords.map((word, i) => (
          <>
            <span class="mask">
              <span class:list={['hero-word', word === hero.accentWord && 'accent']}>{word}</span>
            </span>
            {i < headlineWords.length - 1 && ' '}
          </>
        ))
      }
    </h1>
    <p class="hero-text hero-fade">{hero.support}</p>
    <div class="hero-ctas hero-fade">
      <CtaButton size="large" class="hero-cta" />
      <a class="button button--soft button--large" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>

  <div class="device-wrap">
    <div class="device">
      <div class="bezel">
        <BriefPanel />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 4.5rem;
    isolation: isolate;
  }

  .hero-grid {
    position: absolute;
    inset: 0 0 auto;
    height: 35rem;
    z-index: -1;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center -1px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 30%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 16rem;
    width: min(70rem, 100%);
    height: 40rem;
    margin-inline: auto;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--glow-a) 85%, transparent), transparent 72%);
    opacity: 0.75;
    pointer-events: none;
  }

  .hero-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Review, 24 Nov: a narrower, balanced block (three even lines on desktop) and a
     smaller floor on phones, so it reads in five lines rather than six */
  .h1 {
    max-width: 20ch;
    font-size: clamp(2.125rem, 1.3rem + 3.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .hero-word {
    display: inline-block;
  }

  /* A touch larger and darker than body copy, so it holds its own under the headline */
  .hero-text {
    max-width: 36rem;
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 78%, transparent);
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2.25rem;
  }

  .device-wrap {
    position: relative;
    max-width: 67.5rem;
    margin: 4rem auto 0;
    padding: 0 var(--gutter);
    perspective: 1800px;
  }

  .device {
    transform-origin: 50% 100%;
  }

  .bezel {
    padding: 10px;
    border-radius: 22px;
    background: linear-gradient(160deg, #142a47, #050f1e);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 50px 100px -40px rgb(7 27 52 / 0.55),
      0 20px 40px -30px rgb(7 27 52 / 0.4);
  }

  @media (max-width: 56.25rem) {
    .hero {
      padding-top: 3rem;
    }
  }

  @media (max-width: 45rem) {
    /* The tablet peeks into the first screen: a short gap, and it tilts from its top
       edge, so the tilt doesn't push it down the page (motion.ts uses a gentler tilt) */
    .device-wrap {
      margin-top: 2rem;
      padding: 0 0.75rem;
    }

    .device {
      transform-origin: 50% 0%;
    }

    .bezel {
      padding: 6px;
      border-radius: 16px;
    }
  }
</style>
