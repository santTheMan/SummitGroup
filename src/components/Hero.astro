---
/**
 * Hero after Teal Treasury: the approved promise rises out of line masks,
 * then the working panel stands up from a tilt as it scrolls into view, with
 * the "Update from SGI" card drifting at its own speed. Motion: src/scripts/motion.ts.
 */
import { hero, illustrations } from '../content/site.ts';
import BriefPanel from './BriefPanel.astro';
import CtaButton from './CtaButton.astro';

const headlineWords = hero.headline.split(' ');
const f = illustrations.panel.floats;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-head">
    <h1 class="h1" id="hero-title">
      {
        headlineWords.map((word, i) => (
          <>
            <span class="mask">
              <span class:list={['hero-word', word === hero.accentWord && 'accent']}>{word}</span>
            </span>
            {i < headlineWords.length - 1 && ' '}
          </>
        ))
      }
    </h1>
    <p class="hero-text hero-fade">{hero.support}</p>
    <div class="hero-ctas hero-fade">
      <CtaButton size="large" class="hero-cta" />
      <a class="button button--soft button--large" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>

  <div class="device-wrap">
    <div class="device">
      <div class="bezel">
        <BriefPanel />
      </div>
    </div>
    <div class="floats" aria-hidden="true">
      <div class="float" data-float>
        <div class="float-in">
          <div class="flow">
            <p class="flow-top"><b>{f.update.label}</b> <em>{f.update.text}</em></p>
            <div class="flow-row">
              <span class="flow-chip flow-chip-b"><i></i>{f.update.from}</span>
              <svg class="flow-arrow" width="34" height="10" viewBox="0 0 34 10">
                <path d="M1 5h28"></path><path d="m27 1 4 4-4 4"></path>
              </svg>
              <span class="flow-chip"><i></i>{f.update.to}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 4.5rem;
    isolation: isolate;
  }

  .hero-grid {
    position: absolute;
    inset: 0 0 auto;
    height: 35rem;
    z-index: -1;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center -1px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 30%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 16rem;
    width: min(70rem, 100%);
    height: 40rem;
    margin-inline: auto;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--glow-a) 85%, transparent), transparent 72%);
    opacity: 0.75;
    pointer-events: none;
  }

  .hero-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .h1 {
    max-width: 26ch;
    font-size: var(--t-h1);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .hero-word {
    display: inline-block;
  }

  .hero-text {
    max-width: 35rem;
    margin-top: 1.375rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .device-wrap {
    position: relative;
    max-width: 67.5rem;
    margin: 4rem auto 0;
    padding: 0 var(--gutter);
    perspective: 1800px;
  }

  .device {
    transform-origin: 50% 100%;
  }

  .bezel {
    padding: 10px;
    border-radius: 22px;
    background: linear-gradient(160deg, #142a47, #050f1e);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 50px 100px -40px rgb(7 27 52 / 0.55),
      0 20px 40px -30px rgb(7 27 52 / 0.4);
  }

  .floats {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .float {
    position: absolute;
    left: -4.5rem;
    bottom: -1.75rem;
  }

  .flow {
    width: 20rem;
    padding: 0.75rem;
    border-radius: 12px;
    background: var(--deep);
    color: var(--deep-ink);
    border: 1px solid rgb(255 255 255 / 0.06);
    box-shadow: 0 24px 50px -24px rgb(0 0 0 / 0.55);
  }

  .flow-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin-bottom: 0.625rem;
    font-size: 0.75rem;
    color: var(--deep-muted);
  }

  .flow-top b {
    font-weight: 500;
    color: var(--deep-ink);
  }

  .flow-top em {
    font-style: normal;
    color: var(--sgi-sky);
  }

  .flow-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .flow-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.4375rem 0.5625rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.07);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flow-chip i {
    width: 16px;
    height: 16px;
    flex: none;
    border-radius: 5px;
    background: var(--sgi-electric);
  }

  .flow-chip-b i {
    background: var(--sgi-sky);
  }

  .flow-arrow {
    flex: none;
    color: var(--deep-muted);
  }

  .flow-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .flow-arrow path:first-child {
    stroke-dasharray: 3 4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow-arrow path:first-child {
      animation: dash 1s linear infinite;
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -14;
    }
  }

  @media (max-width: 67.5rem) {
    .float {
      left: -0.5rem;
    }
  }

  @media (max-width: 56.25rem) {
    .hero {
      padding-top: 3rem;
    }

    .floats {
      position: relative;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.625rem;
      margin-top: 1.125rem;
    }

    .float {
      position: relative;
      inset: auto;
    }
  }

  @media (max-width: 45rem) {
    .device-wrap {
      margin-top: 2.75rem;
      padding: 0 0.75rem;
    }

    .bezel {
      padding: 6px;
      border-radius: 16px;
    }

    .flow {
      width: min(21rem, calc(100vw - 3rem));
    }
  }
</style>
