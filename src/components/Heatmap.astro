---
/**
 * Daily placements heatmap, after bklit's HeatmapChart (ui.bklit.com):
 * rounded cells with a 3px gap filling the width, month labels on top,
 * M / W / F down the side, a tooltip and other cells dimming on hover, and a
 * Fewer → More gradient legend. Drawn at build time; the column-wave entrance
 * is in src/scripts/motion.ts and the hover/tooltip in src/scripts/ui.ts.
 */
import { howWeWork } from '../content/site.ts';
import { placementCalendar } from '../lib/placements.ts';

interface Props {
  total: number;
  label: string;
}

const { total, label } = Astro.props;
const copy = howWeWork.placements;
const cal = placementCalendar(copy.from, copy.to, total);
/* Phones: only the last few weeks, re-placed from column 2 (see the phone rules below) */
const recentFrom = Math.max(0, cal.weeks - copy.phoneWeeks);
const pc = (col: number) => col - recentFrom + 2;
/* Tablets and small laptops (721 to 1024px): the last 40 weeks, re-placed the same way */
const tabletFrom = Math.max(0, cal.weeks - copy.tabletWeeks);
const tc = (col: number) => col - tabletFrom + 2;
const dayLabels = ['Mon', '', 'Wed', '', 'Fri', '', ''];
const fmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<div class="hm-wrap" data-heatmap data-one={copy.tooltipOne} data-many={copy.tooltipMany}>
  <div class="hm-scroll" role="img" aria-label={label} data-hm-scroll>
    <div class="hm" style={`--cols:${cal.weeks}; --pcols:${cal.weeks - recentFrom}; --tcols:${cal.weeks - tabletFrom}`} data-hm>
      {
        cal.months.map((m) => (
          <span
            class="hm-month"
            data-old={m.col < recentFrom ? '' : undefined}
            data-old-t={m.col < tabletFrom ? '' : undefined}
            style={`grid-column:${m.col + 2} / span 3; --pc:${pc(m.col)}; --tc:${tc(m.col)}`}
          >
            {m.label}
          </span>
        ))
      }
      {dayLabels.map((d, i) => d && <span class="hm-day" style={`grid-row:${i + 2}`}>{d.charAt(0)}</span>)}
      {
        cal.days.map((d) => (
          <i
            data-l={d.level}
            data-c={d.col}
            data-r={d.row}
            data-n={d.count}
            data-t={fmt.format(new Date(`${d.date}T00:00:00Z`))}
            data-old={d.col < recentFrom ? '' : undefined}
            data-old-t={d.col < tabletFrom ? '' : undefined}
            style={`grid-area:${d.row + 2} / ${d.col + 2}; --pc:${pc(d.col)}; --tc:${tc(d.col)}`}
          />
        ))
      }
    </div>
  </div>
  <p class="hm-tip" data-hm-tip aria-hidden="true"></p>
  <div class="hm-legend" aria-hidden="true">
    <span class="hm-range hm-range--phone">{copy.phoneRange}</span>
    <span class="hm-range hm-range--tablet">{copy.tabletRange}</span>
    <span>{copy.legendLess}</span>
    <i></i>
    <span>{copy.legendMore}</span>
  </div>
</div>

<style>
  .hm-wrap {
    position: relative;
    --l0: #e9e7df;
    --l1: #cde3fb;
    --l2: #8ec2f6;
    --l3: #3f86e0;
    --l4: #173f86;
  }

  /* QA, 24 Nov: phones and tablets show recent weeks, so the chart fits at every
     width and never scrolls. Clipped rather than a scroll box: a scroll box a pixel
     too small became an empty stop for keyboard users. */
  .hm-scroll {
    overflow-x: clip;
    border-radius: 8px;
  }

  .hm {
    display: grid;
    grid-template-columns: 1.25rem repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: auto repeat(7, auto);
    gap: 3px;
    min-width: calc(var(--cols) * 11px + 1.25rem);
    padding-bottom: 2px;
  }

  .hm-month {
    grid-row: 1;
    padding-bottom: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .hm-day {
    grid-column: 1;
    align-self: center;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--muted);
  }

  .hm i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--l0);
    transition: filter 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hm i[data-l='1'] {
    background: var(--l1);
  }

  .hm i[data-l='2'] {
    background: var(--l2);
  }

  .hm i[data-l='3'] {
    background: var(--l3);
  }

  .hm i[data-l='4'] {
    background: var(--l4);
  }

  /* Hovering a day dims the rest (filter, so it never fights the entrance's opacity) */
  .hm[data-hover] i:not([data-active]) {
    filter: opacity(0.3);
  }

  .hm-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    padding: 0.375rem 0.625rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(var(--x, 0), var(--y, 0)) translate(-50%, calc(-100% - 8px));
    transition: opacity 120ms ease;
  }

  .hm-tip[data-on] {
    opacity: 1;
  }

  .hm-tip b {
    font-weight: 500;
  }

  .hm-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .hm-range {
    display: none;
    margin-right: auto;
    white-space: nowrap;
  }

  /* QA, 24 Nov: between phone and desktop the full year and a half was too wide and
     scrolled sideways, so tablets and small laptops show the last 40 weeks */
  @media (min-width: 45.0625rem) and (max-width: 64rem) {
    .hm {
      grid-template-columns: 1.25rem repeat(var(--tcols), minmax(0, 1fr));
      min-width: 0;
    }

    .hm > [data-old-t] {
      display: none;
    }

    .hm > .hm-month {
      grid-column: var(--tc) / span 3 !important;
    }

    .hm > i {
      grid-column: var(--tc) !important;
    }

    .hm-range--tablet {
      display: inline;
    }
  }

  /* Review, 24 Nov: on phones the heatmap shows the last 20 weeks at a readable size,
     rather than a year and a half of tiny squares in a sideways scroll */
  @media (max-width: 45rem) {
    .hm {
      grid-template-columns: 1.25rem repeat(var(--pcols), minmax(0, 1fr));
      min-width: 0;
    }

    .hm > [data-old] {
      display: none;
    }

    .hm > .hm-month {
      grid-column: var(--pc) / span 3 !important;
    }

    .hm > i {
      grid-column: var(--pc) !important;
      border-radius: 3px;
    }

    .hm-range--phone {
      display: inline;
    }

    .hm-legend i {
      width: 4.5rem;
    }
  }

  .hm-legend i {
    width: 7.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--l0), var(--l1), var(--l2), var(--l3), var(--l4));
  }

  @media (prefers-reduced-motion: reduce) {
    .hm i,
    .hm-tip {
      transition: none;
    }
  }
</style>
