---
/**
 * The one primary action: "Book a conversation". Every instance shares the
 * same label and destination (see src/config/env.ts).
 */
import { bookingTemplate, ctaHref } from '../config/env.ts';
import { cta } from '../content/site.ts';

interface Props {
  size?: 'small' | 'default' | 'large';
  class?: string;
  /** Let the closing section fill the booking link's {needs} placeholder. */
  withNeeds?: boolean;
}

const { size = 'default', class: className, withNeeds = false } = Astro.props;
---

<a
  class:list={['button button--primary', size !== 'default' && `button--${size}`, className]}
  href={ctaHref}
  data-booking-template={withNeeds && bookingTemplate ? bookingTemplate : undefined}
>
  <span>{cta.label}</span>
  <svg class="button__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M3 8h9.5M8.75 4.25 12.5 8l-3.75 3.75"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>
