---
/** Small line icons, drawn on a 20px grid with a 1.5px stroke. */
interface Props {
  name: 'chat' | 'people' | 'badge' | 'contact' | 'arrow' | 'chevron' | 'plus' | 'check' | 'menu' | 'close' | 'institute' | 'sales' | 'pathways' | 'route';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  chat: 'M4 5.5A1.5 1.5 0 0 1 5.5 4h9A1.5 1.5 0 0 1 16 5.5v6a1.5 1.5 0 0 1-1.5 1.5H9l-3.5 3v-3h0A1.5 1.5 0 0 1 4 11.5v-6Z',
  people: 'M7.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 16c0-2.5 2-4.25 4.5-4.25S12 13.5 12 16M13 4.25a2.5 2.5 0 0 1 0 4.5M14.5 11.9c1.5.5 2.5 2 2.5 4.1',
  badge: 'm10 3 1.9 1.3 2.3-.1.7 2.2 1.8 1.4-.8 2.2.8 2.2-1.8 1.4-.7 2.2-2.3-.1L10 17l-1.9-1.3-2.3.1-.7-2.2-1.8-1.4.8-2.2-.8-2.2 1.8-1.4.7-2.2 2.3.1L10 3Zm-2.5 7 1.75 1.75L12.75 8.5',
  contact: 'M10 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM4.5 16.5c.9-2.4 3-3.75 5.5-3.75s4.6 1.35 5.5 3.75',
  arrow: 'M4 10h11M11 6l4 4-4 4',
  chevron: 'm6 8 4 4 4-4',
  plus: 'M10 4.5v11M4.5 10h11',
  check: 'm5 10.5 3.25 3.25L15 7',
  menu: 'M3.5 7h13M3.5 13h13',
  close: 'm5.5 5.5 9 9M14.5 5.5l-9 9',
  institute: 'M3 7.5 10 4l7 3.5-7 3.5-7-3.5Zm3 1.5v3.75c1.1 1 2.5 1.5 4 1.5s2.9-.5 4-1.5V9M17 7.5V12',
  sales: 'M3.5 16.5h13M5.5 13.5V10M9 13.5V7.5M12.5 13.5V9M16 13.5V5',
  pathways: 'M4 15.5c3 0 3-5 6-5s3-5 6-5M13.5 3.5 16 5.5l-2.5 2M4 15.5h.01',
  route: 'M5 5.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 12a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 5.5v3a3 3 0 0 0 3 3h4a3 3 0 0 1 3 3',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>
