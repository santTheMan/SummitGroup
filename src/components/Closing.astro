---
/**
 * Start with a conversation: the page's finale for companies.
 *
 * On 22 Nov 2026 Daniel removed the "Your brief" card beside it so the section
 * could carry its own authority. It is now one centred column, the way the hero
 * opens the page: the largest headline since the hero ("conversation." in the
 * accent, as the hero accents "higher."), rising once out of line masks; a lead
 * that says, at display size and in full ink, that SGI stays the client's point
 * of contact (the sentence the card used to whisper); the optional needs
 * (Recruit, Develop, Manage), answered in a line beneath them; and one button.
 *
 * One point of contact is sacred here: no specialist business is named. When the
 * booking link carries a {needs} placeholder, the picks are passed into it.
 *
 * The glows sit in an open, full-width wash that fades in from the page above and
 * back out below, and frame the column like stage lights (blue left, peach right,
 * a white lift behind the words). They follow the pointer on desktop.
 * Motion: src/scripts/motion.ts. Picker: src/scripts/ui.ts (initConversation).
 */
import { bookingUrl } from '../config/env.ts';
import { closing } from '../content/site.ts';
import { words } from '../lib/text.ts';
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';

interface Props {
  /** On the Contact page this section opens the page, so its heading is the h1. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const title = words(closing.heading);
---

<section class="cta-sec" id="book" aria-labelledby="book-title" data-cta>
  <div class="cta-wash" aria-hidden="true">
    <span class="blob blob-a" data-blob></span>
    <span class="blob blob-b" data-blob></span>
    <span class="blob blob-c" data-blob></span>
  </div>

  <div class="wrap">
    <div
      class="finale"
      data-convo
      data-on=""
      data-summary={closing.call.summary}
      data-summary-empty={closing.call.summaryEmpty}
      data-said={closing.call.said}
      data-said-empty={closing.call.empty}
    >
      <Heading class="finale-title" id="book-title" data-finale-title>
        {
          title.map((w, i) => (
            <>
              {i > 0 && !w.glue && ' '}
              <span class="fin-mask">
                <span class:list={['fin-word', w.accent && 'accent']}>{w.text}</span>
              </span>
            </>
          ))
        }
      </Heading>

      <p class="finale-lead">
        {closing.body} <strong>{closing.call.note}</strong>
      </p>

      <div class="needs">
        <p class="needs-k" id="needs-label">
          {closing.needsLabel} <span>{closing.needsHint}</span>
        </p>
        <div class="chips" role="group" aria-labelledby="needs-label">
          {
            closing.needs.map((n) => (
              <button class="chip" type="button" aria-pressed="false" data-need={n.id}>
                <span class="chip-mark" aria-hidden="true">
                  <Icon name="plus" size={14} class="chip-plus" />
                  <Icon name="check" size={14} class="chip-tick" />
                </span>
                {n.label}
              </button>
            ))
          }
        </div>
        <p class="said" data-convo-said>{closing.call.empty}</p>
      </div>

      <div class="cta-action">
        <CtaButton size="large" withNeeds />
      </div>
      {!bookingUrl && <p class="pending" role="note" data-booking-pending>{closing.pendingNotice}</p>}
      <p class="visually-hidden" aria-live="polite" data-convo-summary>{closing.call.summaryEmpty}</p>
    </div>
  </div>
</section>

<style>
  .cta-sec {
    position: relative;
    isolation: isolate;
    padding-block: clamp(7rem, 4rem + 7vw, 10.5rem) clamp(5.5rem, 3rem + 5vw, 8rem);
  }

  /* The wash: a warm tint with the brand glows over it, faded to nothing at the top
     and bottom on an eased curve, so the page runs into the section and out again
     with no edge. Full width, like the talent section's wash below it. */
  .cta-wash {
    --fade: linear-gradient(
      180deg,
      transparent,
      rgb(0 0 0 / 0.12) 7%,
      rgb(0 0 0 / 0.42) 15%,
      rgb(0 0 0 / 0.8) 24%,
      #000 32%,
      #000 70%,
      rgb(0 0 0 / 0.8) 78%,
      rgb(0 0 0 / 0.42) 87%,
      rgb(0 0 0 / 0.12) 94%,
      transparent
    );
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: color-mix(in srgb, var(--glow-c) 62%, var(--page));
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
    pointer-events: none;
  }

  /* Stage lights: blue and peach either side of the column, a wide white lift
     behind the words so the smaller text has the lightest ground. Placed with the
     translate property so Motion's pointer drift (transform) adds to it. */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    translate: -50% -50%;
  }

  .blob-a {
    width: min(42rem, 80vw);
    aspect-ratio: 1;
    left: 15%;
    top: 52%;
    background: var(--glow-a);
  }

  .blob-b {
    width: min(38rem, 72vw);
    aspect-ratio: 1;
    left: 85%;
    top: 56%;
    background: var(--glow-b);
  }

  .blob-c {
    width: min(46rem, 96vw);
    aspect-ratio: 1.6;
    left: 50%;
    top: 46%;
    background: rgb(255 255 255 / 0.55);
  }

  /* ---- The column ---- */
  .finale {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  /* One step past the hero: the page closes louder than it opens. Two lines
     ("Start with a / conversation."), forced by the measure and balanced. */
  .finale-title {
    max-width: 7.5em;
    font-size: var(--t-finale);
    line-height: 1;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .fin-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.06em 0 0.12em;
    margin: -0.06em 0 -0.12em;
  }

  .fin-word {
    display: inline-block;
  }

  /* The lead: context in grey ink, the promise in full ink. 72% ink keeps 5.8:1
     on the brightest glow; the promise is ink at 16:1. */
  .finale-lead {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
    text-wrap: balance;
  }

  .finale-lead strong {
    font-weight: 500;
    color: var(--ink);
  }

  /* ---- Needs picker ---- */
  .needs {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 3rem;
  }

  .needs-k {
    margin-bottom: 0.875rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .needs-k span {
    font-weight: 400;
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  /* The mark is one fixed slot (a plus that turns into a tick), so pressing a
     chip never changes its width and the centred row never shifts. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.125rem 0 0.875rem;
    border-radius: 13px;
    corner-shape: squircle;
    background: rgb(255 255 255 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.9);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      transform var(--press) var(--ease-out),
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  @supports (corner-shape: squircle) {
    .chip {
      border-radius: 17px;
    }
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip-mark {
    display: grid;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .chip-mark :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .chip :global(.chip-plus) {
    color: var(--muted);
  }

  .chip :global(.chip-tick) {
    opacity: 0;
    transform: scale(0.6);
    color: var(--sgi-sky);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .chip[aria-pressed='true'] :global(.chip-plus) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .chip[aria-pressed='true'] :global(.chip-tick) {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip[aria-pressed='false']:hover {
      background: rgb(255 255 255 / 0.88);
    }
  }

  /* The reply: "Not sure yet?" until something is picked, then the brief
     (src/scripts/ui.ts swaps the words and nudges the line in) */
  .said {
    min-height: 1.5em;
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  /* ---- Action ---- */
  .cta-action {
    margin-top: 2rem;
  }

  .pending {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--ink) 66%, transparent);
  }

  @media (max-width: 56.25rem) {
    .blob-a {
      left: 10%;
      top: 36%;
    }

    .blob-b {
      left: 90%;
      top: 72%;
    }

    .blob-c {
      width: 120vw;
      top: 40%;
    }
  }

  @media (max-width: 45rem) {
    .cta-sec {
      padding-block: 6.5rem 5rem;
    }

    .needs {
      margin-top: 2.5rem;
    }

    .chips {
      gap: 0.375rem;
    }

    .chip {
      padding: 0 0.875rem 0 0.75rem;
    }

    .cta-action,
    .cta-action :global(.button) {
      width: min(100%, 20rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .chip-mark :global(svg) {
      transition:
        opacity 160ms ease,
        background-color 180ms ease,
        color 180ms ease;
    }

    .chip:active,
    .chip[aria-pressed='true'] :global(.chip-plus),
    .chip :global(.chip-tick) {
      transform: none;
    }
  }
</style>
