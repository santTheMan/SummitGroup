---
/**
 * Teal Treasury's benefits block: a statement that inks in word by word as it
 * scrolls, then the client revenue gauge (after bklit's Gauge chart) sweeping
 * to its value as its figure counts up. The 450+ / 1 / 3 proof row was
 * removed on 22 Nov 2026 at Daniel's request (the figures stay in site.ts).
 *
 * The revenue block was reworked on 23 Nov 2026 so it draws the eye and follows
 * on from the statement: no hairline above it (and no rule under the section),
 * a larger gauge with the figure at display size inside it, a soft pool of the
 * brand's blue light behind the gauge, and the label set calmer than the
 * statement, so the order reads statement, figure, label, note.
 * Motion: src/scripts/motion.ts and src/scripts/gauge.ts.
 */
import { about, clientRevenue } from '../content/site.ts';
import { plain, words } from '../lib/text.ts';
import Gauge from './Gauge.astro';

const statement = words(about.statement);

/* Compact (9.7M), with the $ and the + written around the count, so it reads $9.7M+ */
const revenueFormat = { notation: 'compact', maximumFractionDigits: 1 } as const;
const revenueText = new Intl.NumberFormat('en-US', revenueFormat).format(clientRevenue.amount);
---

<section class="sec statement" id="about" aria-labelledby="about-label">
  <div class="wrap split">
    <p class="label" id="about-label">{about.eyebrow}</p>
    <div>
      <p class="statement-text" data-statement>
        <span class="visually-hidden">{plain(about.statement)}</span>
        <span aria-hidden="true">
          {
            statement.map((w, i) => (
              <>
                <span class:list={['st-word', w.accent && 'accent']}>{w.text}</span>
                {i < statement.length - 1 && !statement[i + 1]?.glue && ' '}
              </>
            ))
          }
        </span>
      </p>

      <div class="revenue" data-reveal>
        <Gauge
          class="revenue-gauge"
          value={clientRevenue.fill}
          label={clientRevenue.label}
          valueText={clientRevenue.spoken}
          meter={false}
          spacing={25}
          inactiveFillOpacity={0.4}
          delay={0.3}
          duration={2.6}
        >
          <span class="revenue-value"
            >{clientRevenue.prefix}<span
              data-gauge-count
              data-total={clientRevenue.amount}
              data-format={JSON.stringify(revenueFormat)}>{revenueText}</span
            ><span class="revenue-plus">{clientRevenue.suffix}</span></span
          >
          <span class="revenue-caption">Client revenue</span>
        </Gauge>
        <div class="revenue-text">
          <p class="revenue-label" aria-hidden="true">{clientRevenue.label}</p>
          <p class="revenue-note">{clientRevenue.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .statement-text {
    max-width: 51rem;
    font-family: var(--font-display);
    font-size: var(--t-statement);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Client revenue: the gauge leads, its figure large, the label and note beside it.
     24 Nov (Daniel): more room under the statement, and on desktop the gauge is the
     focus: 28rem across (it was 21rem), a larger figure and a fuller pool of light.
     Tablets and phones keep their sizes (below). */
  .revenue {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    max-width: 53rem;
    margin-top: clamp(4.5rem, 2.5rem + 4vw, 7rem);
  }

  /* A soft pool of brand light behind the gauge: it draws the eye without a box */
  .revenue::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 14rem;
    top: 50%;
    width: min(48rem, 120vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      var(--glow-a),
      color-mix(in srgb, var(--glow-a) 55%, transparent) 45%,
      color-mix(in srgb, var(--glow-a) 18%, transparent) 75%,
      transparent
    );
    pointer-events: none;
  }

  /* The figure at display size: as large as the gauge's centre allows */
  /* The + joins the figure once the count lands (gauge.ts marks [data-counting] while
     it climbs). Without JavaScript or motion there is no count, so it simply shows. */
  .revenue-plus {
    transition: opacity 300ms ease;
  }

  :global([data-counting]) .revenue-plus {
    opacity: 0;
    transition: none;
  }

  .revenue-value {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1rem + 2.8vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .revenue-caption {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  /* Calmer than the statement above it, so the figure leads */
  .revenue-label {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* 72% ink, not --muted: it can sit on the edge of the blue light */
  .revenue-note {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: var(--t-small);
    color: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  @media (max-width: 56.25rem) {
    .revenue {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }

    .revenue::before {
      left: 9rem;
      width: min(34rem, 120vw);
    }

    .revenue-value {
      font-size: clamp(1.875rem, 1.2rem + 2vw, 2.625rem);
    }

    .revenue-caption {
      font-size: var(--t-small);
    }
  }

  @media (max-width: 45rem) {
    .revenue {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.5rem;
      margin-top: 4rem;
      text-align: center;
    }

    .revenue::before {
      left: 50%;
      top: 9rem;
    }

    .revenue-gauge {
      max-width: 18rem;
    }

    .revenue-label,
    .revenue-note {
      margin-inline: auto;
    }
  }
</style>
