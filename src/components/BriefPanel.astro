---
/**
 * The hero tablet: one picture of what SGI does, for someone who has never
 * heard of it and only scrolls past.
 *
 * On 22 Nov 2026 Daniel asked for the tablet to be simplified so a newcomer
 * leaves with a picture in their head. The old dashboard (sidebar, stage
 * switcher, gauge, status cards, activity log) became this:
 *  - left: an example brief in large type, then the three things SGI does,
 *    Recruit, Develop and Manage, in plain words;
 *  - right: the team of 12, as seats. As the tablet stands up on scroll, the
 *    seats fill with people (Recruit), each turns Summit-Ready (Develop), and
 *    the whole team is framed as one, with SGI as the one point of contact
 *    (Manage). The steps on the left light up in step with the seats.
 *
 * The markup is the finished state, so without motion (reduced motion, no
 * JavaScript) the tablet simply shows the finished team. The scroll story is
 * in src/scripts/motion.ts. SGI is the only contact named: no specialist
 * business appears here. All of it is illustrative (src/content/site.ts →
 * illustrations.panel).
 */
import icon from '../assets/brand/SGI-icon-colour.svg';
import { closing, illustrations } from '../content/site.ts';
import Icon from './Icon.astro';

const p = illustrations.panel;
const seats = Array.from({ length: p.teamSize }, (_, i) => i);
---

<div class="tab" data-panel data-team-story data-managed>
  <div class="tab-bar">
    <span class="tab-brand">
      <img src={icon.src} width="22" height="11" alt="" />
      {p.workspace}
    </span>
    <span class="tab-contact">
      <Icon name="contact" size={14} />
      {p.contact}
    </span>
    <span class="tab-note">{illustrations.note}</span>
  </div>

  <div class="tab-body">
    <div class="tab-brief">
      <div class="tab-head">
        <p class="tab-k">{p.briefLabel}</p>
        <p class="tab-title">{p.briefTitle}</p>
        <p class="tab-meta">{p.teamSize} {p.teamLabel} · <b>{p.speed}</b></p>
      </div>

      <ol class="tab-steps">
        {
          closing.needs.map((n, i) => (
            <li data-step data-state="done">
              <span class="st-n" aria-hidden="true">
                <span class="st-num">{i + 1}</span>
                <Icon name="check" size={12} class="st-tick" />
              </span>
              <span class="st-txt">
                <b>{n.label}</b>
                <small>{n.detail}</small>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tab-team" data-team-view>
      <div class="team-grid" aria-hidden="true">
        {
          seats.map((i) => (
            <span class="seat" data-seat data-s="2" style={`--i:${i}`}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="8.5" r="4" />
                <path d="M4 21c0-4.6 3.6-7.6 8-7.6s8 3 8 7.6z" />
              </svg>
              <span class="seat-tick">
                <Icon name="check" size={10} />
              </span>
            </span>
          ))
        }
      </div>
      <p class="team-count" aria-hidden="true">
        <span><b data-count="people">{p.teamSize}</b>/{p.teamSize} {p.teamLabel}</span>
        <span><b data-count="ready">{p.teamSize}</b>/{p.teamSize} {p.readyLabel}</span>
      </p>
      <p class="team-one">
        <Icon name="contact" size={16} />
        {p.footer}
      </p>
    </div>
  </div>
</div>

<style>
  .tab {
    display: flex;
    flex-direction: column;
    min-height: 35rem;
    border-radius: 13px;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    text-align: left;
  }

  /* ---- Top bar: who this is with, and that it is an example ---- */
  .tab-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
  }

  .tab-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .tab-brand img {
    width: 22px;
    height: auto;
  }

  .tab-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sgi-electric) 9%, transparent);
    color: var(--accent-text);
    font-weight: 500;
  }

  .tab-note {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--page);
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* ---- Body: the brief and the three steps on the left, the team on the right ---- */
  .tab-body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 3rem;
    padding: 2.25rem 2.5rem 2.5rem;
  }

  .tab-k {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tab-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .tab-meta {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .tab-meta b {
    font-weight: 500;
    color: var(--accent-text);
  }

  /* Steps: next (grey), now (electric number), done (electric tick) */
  .tab-steps {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.75rem;
  }

  .tab-steps li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 12px;
    transition: background-color 220ms ease;
  }

  .st-n {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--rule);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease;
  }

  .st-n > * {
    grid-area: 1 / 1;
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .st-n :global(.st-tick) {
    opacity: 0;
    transform: scale(0.6);
  }

  .st-txt {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .st-txt b {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 220ms ease;
  }

  .st-txt small {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  li[data-state='now'] {
    background: color-mix(in srgb, var(--sgi-sky) 14%, transparent);
  }

  li[data-state='now'] .st-n {
    background: var(--sgi-electric);
    border-color: var(--sgi-electric);
    color: var(--paper);
  }

  li[data-state='done'] .st-n {
    border-color: var(--sgi-electric);
    color: var(--accent-text);
  }

  li[data-state='done'] .st-num {
    opacity: 0;
    transform: scale(0.6);
  }

  li[data-state='done'] .st-n :global(.st-tick) {
    opacity: 1;
    transform: none;
  }

  li[data-state='now'] .st-txt b,
  li[data-state='done'] .st-txt b {
    color: var(--ink);
  }

  /* ---- The team: twelve seats that fill, turn Summit-Ready, then become one team ---- */
  .tab-team {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .team-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    max-width: 26rem;
  }

  /* The "one team" frame, drawn round the seats once SGI manages them */
  .team-grid::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: 24px;
    corner-shape: squircle;
    border: 1.5px solid color-mix(in srgb, var(--sgi-electric) 45%, transparent);
    background: color-mix(in srgb, var(--sgi-sky) 7%, transparent);
    z-index: -1;
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 260ms var(--ease-out),
      transform 260ms var(--ease-out);
  }

  [data-managed] .team-grid::after {
    opacity: 1;
    transform: none;
  }

  .team-grid {
    isolation: isolate;
  }

  .seat {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 16px;
    corner-shape: squircle;
    border: 1.5px dashed color-mix(in srgb, var(--ink) 18%, transparent);
    background: transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .seat svg {
    width: 44%;
    color: color-mix(in srgb, var(--ink) 14%, transparent);
    transform: translateY(6%) scale(0.9);
    transition:
      color 220ms ease,
      transform 260ms var(--ease-out);
  }

  .seat[data-s='1'],
  .seat[data-s='2'] {
    border-style: solid;
    border-color: color-mix(in srgb, var(--sgi-sky) 40%, var(--rule));
    background: color-mix(in srgb, var(--sgi-sky) 16%, var(--paper));
  }

  .seat[data-s='1'] svg,
  .seat[data-s='2'] svg {
    color: var(--sgi-navy);
    transform: translateY(6%);
  }

  .seat-tick {
    position: absolute;
    top: 7%;
    right: 7%;
    display: grid;
    place-items: center;
    width: 26%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sgi-electric);
    color: var(--paper);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .seat[data-s='2'] .seat-tick {
    opacity: 1;
    transform: none;
  }

  .team-count {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .team-count b {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
  }

  .team-one {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-text);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 240ms var(--ease-out),
      transform 240ms var(--ease-out);
  }

  [data-managed] .team-one {
    opacity: 1;
    transform: none;
  }

  /* Tablets: the team sits a little smaller beside the brief */
  @media (max-width: 64rem) {
    .tab-body {
      gap: 2rem;
      padding: 1.75rem;
    }
  }

  /* Phones: the brief, then the team (the picture), then the steps */
  @media (max-width: 45rem) {
    .tab {
      min-height: 0;
    }

    .tab-bar {
      padding: 0.75rem 1rem;
      gap: 0.5rem;
      font-size: 0.75rem;
    }

    .tab-brand {
      font-size: 0.8125rem;
    }

    .tab-note {
      display: none;
    }

    .tab-body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
      padding: 1.25rem 1.25rem 1.5rem;
    }

    .tab-brief {
      display: contents;
    }

    .tab-team {
      order: 1;
    }

    .tab-steps {
      order: 2;
      margin-top: 0;
    }

    .team-grid {
      gap: 0.5rem;
      max-width: 18rem;
    }

    .team-grid::after {
      inset: -0.5rem;
      border-radius: 18px;
    }

    .seat {
      border-radius: 12px;
    }

    .team-count {
      margin-top: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seat svg,
    .seat-tick,
    .st-n > *,
    .team-grid::after,
    .team-one {
      transition: none;
    }
  }
</style>
