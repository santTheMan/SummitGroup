---
/**
 * The hero tablet: one picture of what SGI does, for someone who has never
 * heard of it and only scrolls past.
 *
 * On 22 Nov 2026 Daniel asked for the tablet to be simplified so a newcomer
 * leaves with a picture in their head. The old dashboard (sidebar, stage
 * switcher, gauge, status cards, activity log) became this:
 *  - left: an example brief in large type, then the three things SGI does,
 *    Recruit, Develop and Manage, in plain words;
 *  - right: the team of 12, as seats. Each seat is a small profile: an initials
 *    avatar, first name and surname initial, role and city (invented for the
 *    illustration, no photos; Daniel asked for them on 22 Nov so the team feels
 *    like people, not icons). As the tablet stands up on scroll, the open roles
 *    fill with people (Recruit), each gets a Summit-Ready tick (Develop), and
 *    the whole team is framed as one, with SGI as the one point of contact
 *    (Manage). The steps on the left light up in step with the seats.
 *
 * The markup is the finished state, so without motion (reduced motion, no
 * JavaScript) the tablet simply shows the finished team. The scroll story is
 * in src/scripts/motion.ts. SGI is the only contact named: no specialist
 * business appears here. All of it is illustrative (src/content/site.ts →
 * illustrations.panel).
 */
import icon from '../assets/brand/SGI-icon-colour.svg';
import { closing, illustrations } from '../content/site.ts';
import Icon from './Icon.astro';

const p = illustrations.panel;
/* Each seat is a profile: initials, first name and surname initial, role and city (invented
   for the illustration, no photos). Avatar tones run through the brand palette. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
const seats = p.team.map((m, i) => ({ ...m, initials: initials(m.name), tone: i % 5 }));
/* Phones show the first few people and a "+7 more" tile, so the tablet stays short */
const phoneSeats = 5;
---

<div class="tab" data-panel data-team-story data-managed>
  <div class="tab-bar">
    <span class="tab-brand">
      <img src={icon.src} width="22" height="11" alt="" />
      {p.workspace}
    </span>
    <span class="tab-contact">
      <Icon name="contact" size={14} />
      {p.contact}
    </span>
    <span class="tab-note">{illustrations.note}</span>
  </div>

  <div class="tab-body">
    <div class="tab-brief">
      <div class="tab-head">
        <p class="tab-k">{p.briefLabel}</p>
        <p class="tab-title">{p.briefTitle}</p>
        <p class="tab-meta">{p.teamSize} {p.teamLabel} · <b>{p.speed}</b></p>
      </div>

      <ol class="tab-steps">
        {
          closing.needs.map((n, i) => (
            <li data-step data-state="done">
              <span class="st-n" aria-hidden="true">
                <span class="st-num">{i + 1}</span>
                <Icon name="check" size={12} class="st-tick" />
              </span>
              <span class="st-txt">
                <b>{n.label}</b>
                <small>{n.detail}</small>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tab-team" data-team-view>
      <div class="team-grid" aria-hidden="true">
        {
          seats.map((m) => (
            <span class={`seat tone-${m.tone}`} data-seat data-s="2">
              <span class="seat-av">
                <span class="seat-initials">{m.initials}</span>
                <span class="seat-tick">
                  <Icon name="check" size={10} />
                </span>
              </span>
              <span class="seat-name">
                <b>{m.name}</b>
                <i>{p.openLabel}</i>
              </span>
              <small class="seat-role">{m.role}</small>
              <small class="seat-city">{m.city}</small>
            </span>
          ))
        }
        <span class="seat-more">
          <b>+{p.teamSize - phoneSeats}</b>
          <small>more</small>
        </span>
      </div>
      <p class="team-count" aria-hidden="true">
        <span><b data-count="people">{p.teamSize}</b>/{p.teamSize} {p.teamLabel}</span>
        <span><b data-count="ready">{p.teamSize}</b>/{p.teamSize} {p.readyLabel}</span>
      </p>
      <p class="team-one">
        <Icon name="contact" size={16} />
        {p.footer}
      </p>
    </div>
  </div>
</div>

<style>
  .tab {
    display: flex;
    flex-direction: column;
    min-height: 35rem;
    border-radius: 13px;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    text-align: left;
  }

  /* ---- Top bar: who this is with, and that it is an example ---- */
  .tab-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
  }

  .tab-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .tab-brand img {
    width: 22px;
    height: auto;
  }

  .tab-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sgi-electric) 9%, transparent);
    color: var(--accent-text);
    font-weight: 500;
  }

  .tab-note {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--page);
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* ---- Body: the brief and the three steps on the left, the team on the right ---- */
  .tab-body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 3rem;
    padding: 2.25rem 2.5rem 2.5rem;
  }

  .tab-k {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tab-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.1rem + 2.1vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .tab-meta {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .tab-meta b {
    font-weight: 500;
    color: var(--accent-text);
  }

  /* Steps: next (grey), now (electric number), done (electric tick) */
  .tab-steps {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.75rem;
  }

  .tab-steps li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 12px;
    transition: background-color 220ms ease;
  }

  .st-n {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--rule);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease;
  }

  .st-n > * {
    grid-area: 1 / 1;
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .st-n :global(.st-tick) {
    opacity: 0;
    transform: scale(0.6);
  }

  .st-txt {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .st-txt b {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 220ms ease;
  }

  .st-txt small {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  li[data-state='now'] {
    background: color-mix(in srgb, var(--sgi-sky) 14%, transparent);
  }

  li[data-state='now'] .st-n {
    background: var(--sgi-electric);
    border-color: var(--sgi-electric);
    color: var(--paper);
  }

  li[data-state='done'] .st-n {
    border-color: var(--sgi-electric);
    color: var(--accent-text);
  }

  li[data-state='done'] .st-num {
    opacity: 0;
    transform: scale(0.6);
  }

  li[data-state='done'] .st-n :global(.st-tick) {
    opacity: 1;
    transform: none;
  }

  li[data-state='now'] .st-txt b,
  li[data-state='done'] .st-txt b {
    color: var(--ink);
  }

  /* ---- The team: twelve seats that fill, turn Summit-Ready, then become one team ---- */
  .tab-team {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .team-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.625rem;
    width: 100%;
    max-width: 30rem;
  }

  /* The "one team" frame, drawn round the seats once SGI manages them */
  .team-grid::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: 24px;
    corner-shape: squircle;
    border: 1.5px solid color-mix(in srgb, var(--sgi-electric) 45%, transparent);
    background: color-mix(in srgb, var(--sgi-sky) 7%, transparent);
    z-index: -1;
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 260ms var(--ease-out),
      transform 260ms var(--ease-out);
  }

  [data-managed] .team-grid::after {
    opacity: 1;
    transform: none;
  }

  /* ---- A seat is a profile: avatar, name, role, city ----
     Empty (0): a dashed seat with its role and "Open role". Placed (1): the person
     arrives. Summit-Ready (2): a tick lands on their avatar. Text never fades below
     its colour token, so every label keeps 4.5:1 on the white tablet. */
  .seat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-width: 0;
    padding: 0.75rem 0.375rem 0.6875rem;
    border-radius: 16px;
    corner-shape: squircle;
    border: 1.5px dashed color-mix(in srgb, var(--ink) 18%, transparent);
    background: transparent;
    text-align: center;
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  /* Review, 24 Nov: placed people carry no box of their own, so twelve tiles don't
     compete with the brief. The team frame (below) holds them together. */
  .seat[data-s='1'],
  .seat[data-s='2'] {
    border-color: transparent;
  }

  /* Avatar tones run through the brand palette, so the team reads as different people */
  .tone-0 {
    --av-bg: var(--sgi-navy);
    --av-fg: var(--paper);
  }

  .tone-1 {
    --av-bg: color-mix(in srgb, var(--sgi-sky) 38%, var(--paper));
    --av-fg: var(--sgi-navy);
  }

  .tone-2 {
    --av-bg: var(--sgi-electric);
    --av-fg: var(--paper);
  }

  .tone-3 {
    --av-bg: var(--glow-b);
    --av-fg: var(--sgi-navy);
  }

  .tone-4 {
    --av-bg: var(--glow-a);
    --av-fg: var(--sgi-navy);
  }

  .seat-av {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    margin-bottom: 0.375rem;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    background: transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .seat-initials {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--av-fg);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 200ms var(--ease-out),
      transform 240ms var(--ease-out);
  }

  .seat[data-s='1'] .seat-av,
  .seat[data-s='2'] .seat-av {
    border-color: transparent;
    background: var(--av-bg);
  }

  .seat[data-s='1'] .seat-initials,
  .seat[data-s='2'] .seat-initials {
    opacity: 1;
    transform: none;
  }

  /* Summit-Ready: a tick on the avatar, like a verified badge */
  .seat-tick {
    position: absolute;
    right: -4px;
    bottom: -3px;
    display: grid;
    place-items: center;
    width: 1.0625rem;
    height: 1.0625rem;
    border-radius: 50%;
    background: var(--sgi-electric);
    color: var(--paper);
    box-shadow: 0 0 0 2px var(--paper);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .seat[data-s='2'] .seat-tick {
    opacity: 1;
    transform: none;
  }

  /* Name and "Open role" share one line, so the tile never changes height */
  .seat-name {
    display: grid;
    max-width: 100%;
  }

  .seat-name > * {
    grid-area: 1 / 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.8125rem;
    transition: opacity 200ms var(--ease-out);
  }

  .seat-name b {
    font-weight: 500;
    color: var(--ink);
    opacity: 0;
  }

  .seat-name i {
    font-style: normal;
    color: var(--muted);
  }

  .seat[data-s='1'] .seat-name b,
  .seat[data-s='2'] .seat-name b {
    opacity: 1;
  }

  .seat[data-s='1'] .seat-name i,
  .seat[data-s='2'] .seat-name i {
    opacity: 0;
  }

  .seat-role,
  .seat-city {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .seat-city {
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }

  .seat[data-s='1'] .seat-city,
  .seat[data-s='2'] .seat-city {
    opacity: 1;
  }

  .team-count {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .team-count span {
    white-space: nowrap;
  }

  .team-count b {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
  }

  .team-one {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-text);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 240ms var(--ease-out),
      transform 240ms var(--ease-out);
  }

  [data-managed] .team-one {
    opacity: 1;
    transform: none;
  }

  /* "+7 more": phones only */
  .seat-more {
    display: none;
  }

  /* Tablets: the team sits a little smaller beside the brief */
  @media (max-width: 64rem) {
    .tab-body {
      gap: 2rem;
      padding: 1.75rem;
    }
  }

  /* Phones: the brief, then the team (the picture), then the steps */
  @media (max-width: 45rem) {
    .tab {
      min-height: 0;
    }

    .tab-bar {
      padding: 0.75rem 1rem;
      gap: 0.5rem;
      font-size: 0.75rem;
    }

    .tab-brand {
      font-size: 0.8125rem;
    }

    .tab-note {
      display: none;
    }

    .tab-body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
      padding: 1.25rem 1.25rem 1.5rem;
    }

    .tab-brief {
      display: contents;
    }

    .tab-team {
      order: 1;
    }

    .tab-steps {
      order: 2;
      margin-top: 0;
    }

    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      max-width: 22rem;
    }

    .team-grid::after {
      inset: -0.5rem;
      border-radius: 18px;
    }

    .seat {
      padding: 0.5rem 0.25rem;
      border-radius: 13px;
    }

    /* Five people and a "+7 more" tile: two rows instead of four */
    .seat:nth-child(n + 6) {
      display: none;
    }

    .seat-more {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.125rem;
      border-radius: 13px;
      background: color-mix(in srgb, var(--sgi-sky) 14%, var(--paper));
      color: var(--ink);
    }

    .seat-more b {
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .seat-more small {
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .seat-av {
      width: 2.375rem;
      height: 2.375rem;
      margin-bottom: 0.25rem;
    }

    .seat-initials {
      font-size: 0.8125rem;
    }

    .seat-name > * {
      font-size: 0.9375rem;
    }

    /* Narrow tiles: the role may take two lines ("Account manager"), the city goes */
    .seat-role {
      white-space: normal;
      text-wrap: balance;
      font-size: 0.75rem;
    }

    .seat-city {
      display: none;
    }

    .team-count {
      margin-top: 1.125rem;
      font-size: 0.9375rem;
    }

    .team-count b {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seat,
    .seat-av,
    .seat-initials,
    .seat-name > *,
    .seat-city,
    .seat-tick,
    .st-n > *,
    .team-grid::after,
    .team-one {
      transition: none;
    }
  }
</style>
