---
/**
 * Who we work with: the three audiences as a quiet list beside the "Where
 * we work" dot map. Type only (22 Nov 2026: Daniel removed every card
 * illustration and the per-card booking links), so the map is the one
 * picture in the section.
 */
import { audiences } from '../content/site.ts';
import WorldMap from './WorldMap.astro';
---

<section class="sec aud" id="who-we-work-with" aria-labelledby="aud-title">
  <div class="wrap">
    <div class="split head" data-reveal>
      <p class="label">{audiences.eyebrow}</p>
      <h2 class="h2" id="aud-title">{audiences.heading}</h2>
    </div>

    <div class="aud-grid">
      <ul class="cards">
        {
          audiences.groups.map((g, i) => (
            <li class:list={['card', `card--${i}`]}>
              <h3 class="card-title">{g.title}</h3>
              <p class="card-text">{g.body}</p>
            </li>
          ))
        }
      </ul>
      <WorldMap />
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 3rem;
  }

  /* The audiences down the left, the map across the right */
  .aud-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.85fr);
    gap: 3.5rem;
    align-items: center;
  }

  .cards {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each audience under its own hairline, as the proof points are */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .card:last-child {
    padding-bottom: 0;
  }

  .card-title {
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .card-text {
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  /* Tablet: the map across the top, the audiences in three columns beneath */
  @media (max-width: 56.25rem) {
    .aud-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .aud-grid > :global(.map) {
      order: -1;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .card {
      padding-bottom: 0;
    }
  }

  /* Phone: one column */
  @media (max-width: 45rem) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .card {
      padding-bottom: 1.5rem;
    }
  }
</style>
