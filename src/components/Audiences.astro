---
/**
 * Lilac Meadow's three feature cards (one light, two dark), each carrying a
 * small working piece of UI in the shadcn manner instead of a drawing:
 *   corporates: three separate suppliers collapse into one SGI relationship;
 *   international: 24/7 cover, with the live local time in New York, London
 *     and Sydney on a fully lit 24-hour day;
 *   partners: your organisation and SGI on one talent pipeline.
 * States are driven by src/scripts/motion.ts (entrances) and ui.ts (clock).
 * Each illustration floats over a soft ground shadow, its inner pieces on
 * their own timings (.floating in global.css).
 * Without JavaScript or with reduced motion every card shows its end state.
 */
import iconColour from '../assets/brand/SGI-icon-colour.svg';
import iconReversed from '../assets/brand/SGI-icon-reversed.svg';
import { ctaHref } from '../config/env.ts';
import { audiences, cta } from '../content/site.ts';
import Icon from './Icon.astro';
import WorldMap from './WorldMap.astro';

const v = audiences.visuals;
const supplierIcons = ['people', 'institute', 'sales'] as const;

/* Static first render of the clocks (build time); ui.ts keeps them live. */
const now = new Date();
const hours = Array.from({ length: 24 }, (_, h) => h);
const cover = v.coverage.cities.map((c) => {
  const [h, m] = new Intl.DateTimeFormat('en-GB', { timeZone: c.zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
    .format(now)
    .split(':')
    .map(Number) as [number, number];
  return { ...c, time: `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`, hour: h, now: (h + m / 60) / 24 };
});
---

<section class="sec aud" id="who-we-work-with" aria-labelledby="aud-title">
  <div class="wrap">
    <div class="split head" data-reveal>
      <p class="label">{audiences.eyebrow}</p>
      <h2 class="h2" id="aud-title">{audiences.heading}</h2>
    </div>

    <WorldMap />

    <ul class="cards" data-floats data-float-paused>
      {
        audiences.groups.map((g, i) => (
          <li class="card">
            <h3 class="card-title">{g.title}</h3>

            {i === 0 && (
              <div class="merge" data-merge data-state="after">
                <div class="merge-toggle" role="group" aria-label={g.title}>
                  {v.suppliers.toggle.map((label, j) => (
                    <button type="button" aria-pressed={j === 1 ? 'true' : 'false'} data-merge-btn={j === 0 ? 'before' : 'after'}>
                      {label}
                    </button>
                  ))}
                  <span class="merge-toggle-active" aria-hidden="true">
                    {v.suppliers.toggle.map((label) => <span>{label}</span>)}
                  </span>
                </div>
                <div class="float-unit merge-float">
                <div class="merge-stage floating" aria-hidden="true" style="--f-amp:7px; --f-dur:6.4s">
                <ul class="merge-before">
                  {v.suppliers.before.map((name, j) => (
                    <li class="row" style={`--shift:${(1 - j) * 60 + 12 + j * 9}px; --s:${0.95 - j * 0.04}; --o:${1 - j * 0.15}; --z:${3 - j}; --d:${j * 40}ms`}>
                      <span class="row-ic">
                        <Icon name={supplierIcons[j] ?? 'people'} size={16} />
                      </span>
                      <span class="row-txt">
                        <b>{name}</b>
                        <small>{v.suppliers.beforeMeta}</small>
                      </span>
                      <span class="row-tag">{j + 1}</span>
                    </li>
                  ))}
                </ul>
                <div class="row merge-after floating" style="--f-amp:4px; --f-dur:4.8s; --f-delay:-1.4s">
                  <span class="row-ic row-ic--sgi">
                    <img src={iconColour.src} width="22" height="11" alt="" />
                  </span>
                  <span class="row-txt">
                    <b>{v.suppliers.after}</b>
                    <small>{v.suppliers.afterMeta}</small>
                  </span>
                  <span class="badge">
                    <Icon name="check" size={12} />
                    {v.suppliers.badge}
                  </span>
                </div>
                </div>
                <span class="float-shadow" style="--f-dur:6.4s; --f-shadow-y:-1rem" />
                </div>
              </div>
            )}

            {i === 1 && (
              <div class="float-unit">
              <div class="tz floating" data-tz data-on aria-hidden="true" style="--f-amp:8px; --f-dur:6.9s; --f-delay:-2.2s; --f-rot:-0.35deg">
                <p class="tz-k">
                  <i class="tz-live" />
                  {v.coverage.label}
                </p>
                {cover.map((r, j) => (
                  <div class="tz-row" data-zone={r.zone} style={`--d:${j * 120}ms`}>
                    <span class="tz-city">{r.name}</span>
                    <span class="tz-status">
                      <Icon name="check" size={10} />
                      {v.coverage.status}
                    </span>
                    <span class="tz-time" data-time>
                      {r.time}
                    </span>
                    <span class="tz-day">
                      {hours.map((h) => (
                        <i style={`--h:${h}`} data-hour={h} data-now={h === r.hour ? '' : undefined} />
                      ))}
                    </span>
                  </div>
                ))}
                <p class="tz-cap">{v.coverage.caption}</p>
              </div>
              <span class="float-shadow" style="--f-dur:6.9s; --f-delay:-2.2s" />
              </div>
            )}

            {i === 2 && (
              <div class="float-unit">
              <div class="pipe floating" data-pipe data-on aria-hidden="true" style="--f-amp:8px; --f-dur:7.3s; --f-delay:-4.1s; --f-rot:0.35deg">
                <div class="pipe-orgs">
                  <span class="org floating" style="--f-amp:3px; --f-dur:4.6s; --f-delay:-0.8s">{v.pipeline.partner}</span>
                  <svg class="pipe-link" viewBox="0 0 60 10" preserveAspectRatio="none">
                    <path d="M2 5h56" />
                  </svg>
                  <span class="org org--sgi floating" style="--f-amp:3px; --f-dur:5.1s; --f-delay:-2.9s">
                    <img src={iconReversed.src} width="20" height="10" alt="" />
                    SGI
                  </span>
                </div>
                <p class="pipe-k">{v.pipeline.label}</p>
                <ol class="bars">
                  {v.pipeline.steps.map((step, j) => (
                    <li style={`--w:${100 - j * 12}%; --d:${120 + j * 110}ms`}>
                      <span class="bar-label">
                        <span class="dot">
                          <Icon name="check" size={10} />
                        </span>
                        {step}
                      </span>
                      <span class="bar">
                        <i />
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
              <span class="float-shadow" style="--f-dur:7.3s; --f-delay:-4.1s" />
              </div>
            )}

            <p class="card-text">{g.body}</p>
            <a class="card-link" href={ctaHref}>
              {cta.label}
              <Icon name="arrow" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    margin-bottom: 3rem;
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }

  /* No card boxes: each column's illustration floats straight over the page. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-title {
    max-width: 16ch;
    font-size: 1.5rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .card-text {
    margin-top: 0.75rem;
    max-width: 30rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    width: max-content;
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--accent-text);
  }

  .card-link :global(svg) {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card-link:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  /* ---- Shared row (shadcn-style list item) ---- */
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--paper);
    box-shadow: 0 1px 2px rgb(7 27 52 / 0.04);
  }

  .row-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: var(--page);
    color: var(--muted);
  }

  .row-ic--sgi {
    background: color-mix(in srgb, var(--sgi-sky) 18%, var(--paper));
  }

  .row-ic img {
    width: 20px;
    height: auto;
  }

  .row-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .row-txt b {
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-txt small {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .row-tag {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 7px;
    background: var(--page);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sgi-electric) 10%, transparent);
    color: var(--accent-text);
    font-size: 0.68rem;
    font-weight: 500;
  }

  /* ---- 1. Suppliers merge into one relationship ---- */
  .merge {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .merge-float {
    display: block;
    justify-items: stretch;
  }

  .merge-stage {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    min-height: 12.5rem;
  }

  /* Without SGI / With SGI: the clipped-highlight toggle */
  .merge-toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-self: flex-start;
    padding: 3px;
    border-radius: 12px;
    corner-shape: squircle;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .merge-toggle button,
  .merge-toggle-active span {
    display: grid;
    place-items: center;
    height: 2rem;
    padding: 0 0.875rem;
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .merge-toggle button {
    color: var(--muted);
    border-radius: 9px;
    transition: transform var(--press) var(--ease-out);
  }

  .merge-toggle button:active {
    transform: scale(0.97);
  }

  .merge-toggle-active {
    position: absolute;
    inset: 3px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    border-radius: 9px;
    corner-shape: squircle;
    clip-path: inset(0 0 0 50% round 9px);
    transition: clip-path 280ms var(--ease-out);
  }

  .merge[data-state='before'] .merge-toggle-active {
    clip-path: inset(0 50% 0 0 round 9px);
  }

  .merge-before {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .merge-before .row {
    position: relative;
    z-index: var(--z);
    transition:
      transform 450ms var(--ease-out) var(--d),
      opacity 300ms ease var(--d);
  }

  .merge-after {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    top: 50%;
    border-color: color-mix(in srgb, var(--sgi-electric) 35%, var(--rule));
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--sgi-electric) 8%, transparent),
      0 18px 36px -24px rgb(7 27 52 / 0.45);
    transform: translateY(-50%);
    transition:
      transform 450ms var(--ease-out) 180ms,
      opacity 300ms ease 180ms;
  }

  .merge[data-state='after'] .merge-before .row {
    opacity: var(--o);
    transform: translateY(var(--shift)) scale(var(--s));
  }

  /* Once stacked, only clean card edges peek out from under SGI */
  .merge-before .row > * {
    transition: opacity 200ms ease;
  }

  .merge[data-state='after'] .merge-before .row > * {
    opacity: 0;
  }

  .merge[data-state='before'] .merge-after {
    opacity: 0;
    transform: translateY(-50%) scale(0.96);
    transition-delay: 0ms;
  }

  .merge[data-state='before'] .merge-before .row {
    transition-delay: 0ms;
  }

  /* ---- 2. Covered 24/7 ---- */
  .tz,
  .pipe {
    width: 100%;
  }

  .tz,
  .pipe {
    border-radius: 18px;
    corner-shape: squircle;
    background:
      radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--sgi-electric) 26%, transparent), transparent 70%),
      var(--deep);
    border: 1px solid rgb(255 255 255 / 0.08);
    color: var(--deep-ink);
    box-shadow: 0 30px 60px -30px rgb(7 27 52 / 0.55);
  }

  .tz {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem;
  }

  .tz-k {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.125rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--deep-muted);
  }

  .tz-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tz-live {
      animation: pulse 1.8s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }

  .tz-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.375rem 0.5rem;
    font-size: 0.75rem;
  }

  .tz-city {
    color: var(--deep-ink);
    font-weight: 500;
  }

  .tz-status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.0625rem 0.4375rem 0.0625rem 0.3125rem;
    border-radius: 999px;
    background: rgb(74 222 128 / 0.12);
    color: #86efac;
    font-size: 0.64rem;
  }

  .tz-time {
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--deep-muted);
  }

  /* A whole day in 24 hours, every one lit: the hour it is there now glows white */
  .tz-day {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 2px;
    height: 0.5rem;
  }

  .tz-day i {
    border-radius: 2px;
    background: var(--sgi-sky);
    opacity: 0.6;
    transform-origin: 50% 100%;
    transition:
      transform 500ms var(--ease-out) calc(var(--d) + var(--h) * 18ms),
      opacity 500ms var(--ease-out) calc(var(--d) + var(--h) * 18ms),
      background-color 300ms ease;
  }

  .tz-day i[data-now] {
    background: #fff;
    opacity: 1;
  }

  .tz:not([data-on]) .tz-day i {
    transform: scaleY(0.25);
    opacity: 0.12;
    transition-delay: 0ms;
  }

  .tz-cap {
    font-size: 0.72rem;
    color: var(--deep-muted);
  }

  /* ---- 3. Partner pipeline ---- */
  .pipe {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }

  .pipe-orgs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .org {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: none;
    padding: 0.375rem 0.625rem;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .org--sgi {
    background: color-mix(in srgb, var(--sgi-electric) 35%, transparent);
  }

  .org img {
    width: 18px;
    height: auto;
  }

  .pipe-link {
    flex: 1;
    height: 10px;
    min-width: 1.5rem;
    color: var(--sgi-sky);
  }

  .pipe-link path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pipe-link path {
      animation: dash 1s linear infinite;
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -14;
    }
  }

  .pipe-k {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--deep-muted);
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bars li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .bar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .bar {
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  .bar i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sgi-electric), var(--sgi-sky));
    transform-origin: left;
    transition: transform 700ms var(--ease-out) var(--d);
  }

  .pipe:not([data-on]) .bar i {
    transform: scaleX(0);
    transition-delay: 0ms;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--sgi-sky);
    color: var(--sgi-navy);
    transition:
      background-color 250ms ease var(--d),
      color 250ms ease var(--d);
  }

  .pipe:not([data-on]) .dot {
    background: #13294a;
    color: transparent;
    transition-delay: 0ms;
  }

  @media (max-width: 56.25rem) {
    .cards {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 30rem) {
    .merge-after .badge {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .merge-before .row,
    .merge-before .row > *,
    .merge-toggle-active,
    .merge-after,
    .tz-day i,
    .bar i,
    .dot {
      transition: none;
    }
  }
</style>
