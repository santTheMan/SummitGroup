---
/**
 * SGI horizontal lockup (reversed, for dark backgrounds).
 * Supplied artwork only: rendered at its own aspect ratio, never recoloured
 * or altered. Keep it at least 100px wide; use the icon at smaller sizes.
 * Interim source: 18 Nov pack PNG (see src/content/brand-assets.ts).
 */
import { Image } from 'astro:assets';
import lockupReversed from '../assets/brand/SGI-lockup-reversed-4K.png';
import { brand } from '../content/site.ts';

interface Props {
  /** Rendered height in CSS pixels. */
  height?: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { height = 30, class: className, loading = 'eager' } = Astro.props;
const width = Math.round((lockupReversed.width / lockupReversed.height) * height);
if (width < 100) throw new Error(`The SGI lockup must be at least 100px wide (got ${width}px). Use the icon instead.`);
---

<Image
  src={lockupReversed}
  alt={brand.name}
  width={width}
  height={height}
  densities={[1, 2, 3]}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
