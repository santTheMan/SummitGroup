---
/**
 * Want to work with us? For individuals: SGI works with companies, and its
 * specialist businesses work with people directly.
 *
 * Reworked after Daniel's meeting with Sam (24 Nov 2026): Sam wanted "want to work
 * with us" rather than "looking for a role", then the options of what SGI hires for,
 * from a setter to a strategic hire (his model was careers.netrevenue.io). "A role"
 * now comes first and lists the roles SGI hires for (level, role, one line, remote),
 * and "Training" is the second way in. The heading takes a fixed accent ("work").
 *
 * On 22 Nov 2026 Daniel removed the Summit-Ready journey card beside it so the
 * section could carry its own authority. It is now a question and an answer in
 * type: the heading runs across the full width; below it, the question and the
 * Training / A role toggle sit on the left and the answer is set large on the
 * right, naming the business in full ink. The word the visitor picks in the
 * heading ("training" or "a role") takes the accent, so the question records
 * the answer. It is asymmetric on purpose, so it never echoes the centred
 * finale above it, and smaller, so the company call to action keeps its rank.
 *
 * The toggle uses Emil's clipped-duplicate technique: a second, "active" copy
 * of the options sits on top, clipped to the chosen option, and the clip
 * moves, so the label colour changes exactly at the pill's edge. Both answers
 * share one grid cell, so switching never moves the page.
 *
 * Surface: a soft wash in the brand glows (peach behind the question, sky
 * behind the answer, mirroring the finale above), fading into the page colour
 * on every edge. Behaviour: src/scripts/ui.ts (initTalent).
 */
import { businesses, talentNote } from '../content/site.ts';
import { words } from '../lib/text.ts';
import Icon from './Icon.astro';

const first = talentNote.options[0];
const nameOf: Record<string, string> = Object.fromEntries(businesses.map((b) => [b.id, b.name]));
const title = words(talentNote.heading);
/* Each answer opens with its business's name, which is set in full ink */
const answers = talentNote.options.map((o) => {
  const name = nameOf[o.business] ?? '';
  const lead = name && o.text.startsWith(name) ? name : '';
  return { ...o, lead, tail: o.text.slice(lead.length) };
});
---

<section class="op-sec" aria-labelledby="talent-title">
  <div class="wrap">
    <div class="op" data-talent data-choice-index="0" data-business={first.business} data-reveal>
      <h2 class="h2 op-title" id="talent-title">
        {
          title.map((w, i) => (
            <>
              {i > 0 && !w.glue && ' '}
              {w.accent ? <span class="accent">{w.text}</span> : w.text}
            </>
          ))
        }
      </h2>

      <div class="op-ask">
        <p class="op-body">{talentNote.body}</p>
        <p class="chooser-k" id="talent-q">{talentNote.chooserLabel}</p>
        <div class="toggle" role="group" aria-labelledby="talent-q">
          <span class="toggle-knob" aria-hidden="true"></span>
          <div class="toggle-base">
            {
              talentNote.options.map((o) => (
                <button type="button" aria-pressed={o.id === first.id ? 'true' : 'false'} data-choice-btn={o.id} data-business={o.business}>
                  {o.label}
                </button>
              ))
            }
          </div>
          <div class="toggle-active" aria-hidden="true">
            {talentNote.options.map((o) => <span>{o.label}</span>)}
          </div>
        </div>
      </div>

      <div class="answers" aria-live="polite">
        {
          answers.map((o) => (
            <div class="answer" data-answer={o.id} hidden={o.id !== first.id}>
              <p class="answer-text">
                {o.lead && <strong>{o.lead}</strong>}
                {o.tail}
              </p>
              {o.id === 'role' && (
                <div class="roles">
                  <p class="roles-k">{talentNote.rolesLabel}</p>
                  <ul>
                    {talentNote.roles.map((r) => (
                      <li class="role">
                        <span class="role-level">{r.level}</span>
                        <span class="role-title">{r.title}</span>
                        <span class="role-detail">{r.detail}</span>
                        <span class="role-where">{talentNote.rolesWhere}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <a class="link-arrow" href={`#business-${o.business}`}>
                {o.link}
                <Icon name="arrow" size={16} />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * The wash: a peach glow behind the question and a sky glow behind the answer
   * (the finale's glows, mirrored), over a band that runs page colour, a breath of
   * warmth, page colour. Every layer reaches the page colour or transparent at its
   * edges, so nothing marks where the section starts.
   */
  .op-sec {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 3rem + 3vw, 6rem) 8rem;
  }

  .op-sec::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 62% at 72% 60%, var(--glow-a), transparent 72%),
      radial-gradient(38% 58% at 20% 50%, color-mix(in srgb, var(--glow-b) 85%, transparent), transparent 72%),
      linear-gradient(
        180deg,
        var(--page),
        color-mix(in srgb, var(--glow-c) 55%, var(--page)) 50%,
        var(--page)
      );
    pointer-events: none;
  }

  /* Question across the top; the asking on the left, the answer on the right, their
     last lines level, so the toggle asks and the answer replies */
  .op {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    grid-template-areas:
      'title title'
      'ask answer';
    align-items: end;
    column-gap: clamp(3rem, 1rem + 6vw, 7rem);
    row-gap: clamp(2rem, 1.25rem + 2vw, 3.25rem);
    /* The answer is now taller (it lists the roles): the question sits level with its top */
    align-items: start;
    color: var(--ink);
  }

  .op-title {
    grid-area: title;
  }

  .op-ask {
    grid-area: ask;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 78% ink, not --muted: --muted falls to 4.2:1 on the peach glow */
  .op-body {
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }

  .chooser-k {
    margin: 1.5rem 0 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* ---- Toggle, after Apple's segmented control (23 Nov 2026) ----
     Transparent frosted glass: the track is a clear frosted capsule the wash glows
     through, and the knob a brighter frosted capsule under the chosen option. While pressed, the
     knob lifts into Liquid Glass (Apple's sliders and switches do this): it swells
     on a spring, thins to clear glass and catches the light on its rim, then
     settles back. The labels keep Emil's clipped duplicate: an ink
     copy clipped to the knob, moving on the same curve, so the label colour changes
     exactly at the knob's edge. */
  .toggle {
    position: relative;
    display: inline-grid;
    padding: 4px;
    border-radius: 999px;
    background: var(--frost-sheen), var(--frost-body);
    -webkit-backdrop-filter: var(--frost-blur);
    backdrop-filter: var(--frost-blur);
    box-shadow: var(--frost-edge), var(--frost-shadow);
  }

  .toggle-knob {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: 999px;
    background:
      var(--frost-sheen),
      linear-gradient(180deg, rgb(255 255 255 / 0.96), rgb(255 255 255 / 0.84));
    box-shadow:
      var(--frost-edge),
      0 0 0 1px color-mix(in srgb, var(--sgi-electric) 30%, transparent),
      0 1px 2px rgb(7 27 52 / 0.1),
      0 6px 14px -6px rgb(7 27 52 / 0.3);
    transition:
      transform 260ms var(--ease-out),
      scale var(--glass-flex),
      box-shadow 200ms ease;
  }

  .op[data-choice-index='1'] .toggle-knob {
    transform: translateX(100%);
  }

  .toggle:has(button:active) .toggle-knob {
    scale: 1.1;
    background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.42), rgb(255 255 255 / 0.14));
    box-shadow:
      var(--glass-edge-light),
      var(--glass-thick),
      0 0 0 0.5px rgb(7 27 52 / 0.08),
      0 12px 24px -10px rgb(7 27 52 / 0.35);
    -webkit-backdrop-filter: blur(2px) saturate(2) brightness(1.08);
    backdrop-filter: blur(2px) saturate(2) brightness(1.08);
  }

  .toggle-base,
  .toggle-active {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-area: 1 / 1;
  }

  .toggle-base button,
  .toggle-active span {
    display: grid;
    place-items: center;
    min-width: 9.5rem;
    height: 3rem;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* Review, 24 Nov: the unchosen side recedes; the chosen side is blue on white */
  .toggle-base button {
    color: color-mix(in srgb, var(--ink) 66%, transparent);
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
  }

  .toggle-active {
    pointer-events: none;
    color: var(--action-hover);
    clip-path: inset(0 50% 0 0 round 999px);
    transition: clip-path 260ms var(--ease-out);
  }

  .op[data-choice-index='1'] .toggle-active {
    clip-path: inset(0 0 0 50% round 999px);
  }

  @media (hover: hover) and (pointer: fine) {
    .toggle-base button:hover {
      color: var(--ink);
    }
  }

  /* ---- Answer: statement size, both in one grid cell ---- */
  .answers {
    grid-area: answer;
    display: grid;
  }

  .answer {
    grid-area: 1 / 1;
    max-width: 38rem;
    transition:
      opacity 240ms var(--ease-out) 40ms,
      transform 240ms var(--ease-out) 40ms,
      visibility 0s 0s;
  }

  /* The hidden answer keeps its place (so the cell is as tall as the longer one) and
     leaves faster than the new one arrives, towards its own side of the toggle */
  .answer[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0s 150ms;
  }

  .answer[data-answer='role'][hidden] {
    transform: translateX(-0.75rem);
  }

  .answer[data-answer='training'][hidden] {
    transform: translateX(0.75rem);
  }

  .answer-text {
    font-family: var(--font-display);
    font-size: var(--t-statement);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
    text-wrap: pretty;
  }

  .answer-text strong {
    font-weight: 500;
    color: var(--ink);
  }

  /* Roles SGI hires for, after NetRevenue's open positions but quieter: a level, the
     role, one line, and where it is done. Hairlines between, no cards. The level is
     --action-hover (4.5:1 on the glow); the line is 74% ink. */
  .roles {
    margin-top: 1.5rem;
  }

  .roles-k {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  .roles ul {
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .role {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      'level title where'
      'level detail where';
    column-gap: 1.25rem;
    align-items: baseline;
    padding: 0.875rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .role-level {
    grid-area: level;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--action-hover);
  }

  .role-title {
    grid-area: title;
    font-weight: 500;
  }

  .role-detail {
    grid-area: detail;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  .role-where {
    grid-area: where;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  @media (max-width: 45rem) {
    .role {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'level where'
        'title title'
        'detail detail';
      row-gap: 0.125rem;
    }
  }

  /* --action-hover, not --accent-text: small blue text needs 4.5:1 on the sky glow */
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--action-hover);
  }

  .link-arrow :global(svg) {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .link-arrow:hover :global(svg) {
      transform: translateX(4px);
    }
  }

  @media (max-width: 56.25rem) {
    .op {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'title'
        'ask'
        'answer';
      align-items: start;
      row-gap: 1.75rem;
    }
  }

  @media (max-width: 45rem) {
    .op-sec {
      padding-block: 4rem 6rem;
    }

    .op-ask,
    .toggle {
      width: 100%;
    }

    .toggle-base button,
    .toggle-active span {
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle-active,
    .toggle-knob {
      transition: none;
    }

    .toggle:has(button:active) .toggle-knob {
      scale: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .toggle {
      background: color-mix(in srgb, var(--ink) 6%, var(--paper));
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .toggle-knob,
    .toggle:has(button:active) .toggle-knob {
      background: var(--paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .answer,
    .answer[hidden] {
      transform: none;
    }
  }
</style>
