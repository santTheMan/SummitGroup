---
/**
 * Lilac Meadow's two-column FAQ: the title on the left, rows on the right
 * that open with a plus turning into a cross. Behaviour: src/scripts/ui.ts.
 *
 * It closes the page (Daniel moved it to the end on 22 Nov 2026), straight after
 * the talent section's glow wash. It has no top rule, so the wash fades into it
 * with no line. It carries no booking button (Daniel removed it on 23 Nov 2026):
 * the hero and "Start with a conversation" hold the call to action.
 */
import { faq } from '../content/site.ts';
import Icon from './Icon.astro';
---

<section class="sec faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-side" data-reveal>
      <p class="label">{faq.eyebrow}</p>
      <h2 class="h2" id="faq-title">{faq.heading}</h2>
      <p class="muted">{faq.intro}</p>
    </div>

    <ul class="faq-list" data-reveal>
      {
        faq.items.map((item, i) => (
          <li>
            <h3>
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} data-faq>
                {item.q}
                <span class="plus">
                  <Icon name="plus" size={16} />
                </span>
              </button>
            </h3>
            <div class="collapse" id={`faq-a-${i}`} data-open={i === 0 ? '' : undefined}>
              <div>
                <p>{item.a}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: 4rem;
  }

  .faq-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .faq-side .label {
    padding-top: 0;
    margin-bottom: -0.25rem;
  }

  .faq-side .muted {
    max-width: 22rem;
  }

  .faq-list {
    border-top: 1px solid var(--rule);
  }

  .faq-list li {
    border-bottom: 1px solid var(--rule);
  }

  .faq-list h3 {
    font-family: var(--font-body);
    font-weight: 500;
  }

  .faq-list button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1.25rem 0;
    text-align: left;
    font-size: 1rem;
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-list button:hover {
      color: var(--accent-text);
    }

    .faq-list button:hover .plus {
      color: var(--action-hover);
      box-shadow: var(--frost-edge-tint), var(--frost-shadow-tint);
    }
  }

  /* A transparent frosted glass circle (tokens.css --frost-*), tinted electric with a
     blue edge while its question is open. While its row is pressed it lifts
     into Liquid Glass: it swells on a spring, thins to clear glass and catches the
     light on its rim. Rotation and swell are separate properties. */
  .plus {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--frost-sheen), var(--frost-body);
    -webkit-backdrop-filter: var(--frost-blur);
    backdrop-filter: var(--frost-blur);
    box-shadow:
      var(--frost-edge),
      0 0 0 1px color-mix(in srgb, var(--ink) 14%, transparent),
      var(--frost-shadow);
    color: var(--accent-text);
    transition:
      transform 250ms var(--ease-out),
      scale var(--glass-flex),
      color 200ms ease,
      box-shadow 200ms ease;
  }

  button[aria-expanded='true'] .plus {
    transform: rotate(45deg);
    background: var(--frost-sheen), var(--frost-tint);
    color: var(--action-hover);
    box-shadow: var(--frost-edge-tint), var(--frost-shadow-tint);
  }

  .faq-list button:active .plus {
    scale: 1.15;
    background: var(--glass-sheen), linear-gradient(180deg, rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.15));
    color: var(--ink);
    box-shadow:
      var(--glass-edge-light),
      var(--glass-thick),
      0 0 0 0.5px rgb(7 27 52 / 0.08),
      0 8px 16px -8px rgb(7 27 52 / 0.35);
    -webkit-backdrop-filter: blur(2px) saturate(2) brightness(1.08);
    backdrop-filter: blur(2px) saturate(2) brightness(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-list button:active .plus {
      scale: none;
    }
  }

  @media (prefers-contrast: more) {
    .plus {
      background: var(--paper);
      box-shadow: inset 0 0 0 1.5px var(--ink);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .plus {
      background: var(--paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    button[aria-expanded='true'] .plus {
      background: color-mix(in srgb, var(--sgi-electric) 14%, var(--paper));
    }
  }

  .collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms var(--ease-out);
  }

  .collapse[data-open] {
    grid-template-rows: 1fr;
  }

  .collapse > div {
    overflow: hidden;
    min-height: 0;
  }

  /* Closed answers leave the accessibility tree once the close has played. */
  .collapse:not([data-open]) > div {
    visibility: hidden;
    transition: visibility 0s 300ms;
  }

  .collapse p {
    max-width: 38rem;
    padding: 0 3rem 1.25rem 0;
    color: var(--muted);
  }

  @media (max-width: 56.25rem) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collapse {
      transition: none;
    }
  }
</style>
