---
/**
 * Teal Treasury's coverage block: a statement title, four steps between
 * hairlines, and a card with a daily heatmap of placements, one square per
 * placement day (Heatmap.astro).
 */
import { howWeWork } from '../content/site.ts';
import { publishedProof } from '../lib/release.ts';
import { splitNumber, words } from '../lib/text.ts';
import Heatmap from './Heatmap.astro';
import Icon from './Icon.astro';

const title = words(howWeWork.heading);
const icons = ['chat', 'route', 'badge', 'contact'] as const;
const placements = publishedProof().find((p) => p.id === 'placements');
const count = placements ? (splitNumber(placements.value)?.value ?? 0) : 0;
---

<section class="sec cov" id="how-we-work" aria-labelledby="how-title">
  <div class="wrap">
    <div class="split" data-reveal>
      <p class="label">{howWeWork.eyebrow}</p>
      <h2 class="h2 cov-title" id="how-title">
        {
          title.map((w, i) => (
            <>
              <span class:list={[w.accent && 'accent']}>{w.text}</span>
              {i < title.length - 1 && !title[i + 1]?.glue && ' '}
            </>
          ))
        }
      </h2>
    </div>

    <ol class="steps" data-reveal>
      {
        howWeWork.steps.map((step, i) => (
          <li class="step">
            <span class="step-top">
              <span class="step-ic">
                <Icon name={icons[i] ?? 'check'} />
              </span>
              <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <h3 class="h3 step-title">{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    {
      placements && (
        <div class="calc">
          <div class="calc-head">
            <div>
              <p class="calc-big">{placements.value}</p>
              <p class="calc-label">{placements.label}</p>
            </div>
            <p class="calc-caption">{howWeWork.placements.caption}</p>
          </div>
          <Heatmap total={count} label={`${howWeWork.placements.heading}: ${placements.value} ${placements.label}, shown as a daily heatmap. ${howWeWork.placements.note}`} />
          <p class="fine calc-note">{howWeWork.placements.note}</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .cov {
    border-top: 1px solid var(--rule);
  }

  .cov-title {
    max-width: 48rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  /* Review, 24 Nov: larger, darker descriptions; each step numbered, with a faint
     line running on to the next */
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem 1.25rem 1.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .step-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step-n {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .step:not(:last-child) .step-top::after {
    content: '';
    flex: 1;
    height: 1px;
    margin-right: -1.25rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--sgi-electric) 40%, transparent), transparent);
  }

  .step + .step {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .step p {
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  .step-title {
    margin-top: 1rem;
    font-size: 1.0625rem;
  }

  .step-ic {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--accent-text);
  }

  .calc {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .calc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 1.75rem;
  }

  .calc-big {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .calc-label {
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  .calc-caption {
    max-width: 22rem;
    font-size: var(--t-small);
    color: var(--muted);
    text-align: right;
  }

  .calc-note {
    margin-top: 0.875rem;
    font-size: var(--t-small);
  }

  @media (max-width: 56.25rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step .step-top::after {
      display: none;
    }

    .step:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .step:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }

    .calc {
      padding: 1.375rem;
    }

    .calc-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .calc-caption {
      text-align: left;
    }
  }

  @media (max-width: 45rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step + .step {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

  }

</style>
