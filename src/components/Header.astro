---
import CtaButton from './CtaButton.astro';
import Logo from './Logo.astro';
import { navigation } from '../content/site.ts';
---

<header class="site-header on-dark" data-header data-scrolled="false" data-menu-open="false">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#top">
      <Logo height={30} class="site-header__logo" />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul role="list" class="site-nav__list">
        {
          navigation.map((item) => (
            <li>
              <a class="site-nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <CtaButton size="large" class="site-nav__cta" />
    </nav>

    <div class="site-header__actions">
      <CtaButton size="small" class="site-header__cta" />
      <a class="menu-toggle menu-toggle--fallback" href="#footer-nav">Menu</a>
      <button
        class="menu-toggle menu-toggle--button"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-button
        hidden
      >
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-toggle__label">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { mountHeader } from '../scripts/header.ts';
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) mountHeader(header);
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-height);
    color: var(--text-on-dark);
    border-bottom: 1px solid var(--hairline-on-dark);
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .site-header[data-scrolled='true'],
  .site-header[data-menu-open='true'] {
    background: rgb(7 27 52 / 0.94);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .site-header__brand {
    display: inline-flex;
    flex: none;
    margin-right: auto;
    padding-block: 0.5rem;
    border-radius: var(--radius-sm);
  }

  .site-header__brand :global(.site-header__logo) {
    width: auto;
    height: 26px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__actions :global(.site-header__cta) {
    display: none;
  }

  .site-nav__link {
    display: block;
    text-decoration: none;
    color: var(--text-on-dark-muted);
    transition: color var(--duration-fast) ease;
  }

  .site-nav__link:hover {
    color: var(--sgi-white);
  }

  /* Menu toggle: a button with JS, a link to the footer navigation without. */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--sgi-white);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--hairline-on-dark);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: rgb(243 248 255 / 0.4);
  }

  :global(.js) .menu-toggle--fallback {
    display: none;
  }

  .menu-toggle--button[hidden] {
    display: none;
  }

  .menu-toggle__bars {
    display: grid;
    gap: 5px;
    width: 16px;
  }

  .menu-toggle__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--duration-base) var(--ease-out);
  }

  [data-menu-open='true'] .menu-toggle__bars span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  [data-menu-open='true'] .menu-toggle__bars span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Small and medium screens: navigation lives in a drop-down panel. */
  @media (max-width: 63.99em) {
    .site-nav {
      display: none;
    }

    :global(.js) [data-menu-open='true'] .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      max-height: calc(100svh - var(--header-height));
      overflow-y: auto;
      padding: 0.5rem var(--gutter) 1.75rem;
      background: var(--sgi-navy);
      border-bottom: 1px solid var(--hairline-on-dark);
      box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.6);
    }

    .site-nav__link {
      padding-block: 1rem;
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--sgi-white);
      border-bottom: 1px solid var(--hairline-on-dark);
    }

    .site-nav :global(.site-nav__cta) {
      width: 100%;
      margin-top: 1.5rem;
    }
  }

  @media (min-width: 37.5em) {
    .site-header__brand :global(.site-header__logo) {
      height: 30px;
    }

    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  /* Large screens: centred inline navigation, no menu toggle. */
  @media (min-width: 64em) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
    }

    .site-header__brand {
      justify-self: start;
      margin-right: 0;
    }

    .site-header__actions {
      justify-self: end;
    }

    .site-nav__list {
      display: flex;
      gap: clamp(1.5rem, 2.4vw, 2.5rem);
      font-size: var(--text-sm);
      font-weight: 500;
    }

    .site-nav__link {
      position: relative;
      padding-block: 0.5rem;
    }

    .site-nav__link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.2rem;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-base) var(--ease-out);
    }

    .site-nav__link:hover::after {
      transform: scaleX(1);
    }

    .site-nav :global(.site-nav__cta),
    .menu-toggle {
      display: none !important;
    }
  }
</style>
