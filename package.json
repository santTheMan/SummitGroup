{
  "name": "summit-group-website",
  "version": "0.1.0",
  "private": true,
  "description": "Summit Group International: Phase 1 corporate website.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "check:release": "node --env-file-if-exists=.env scripts/check-release.ts"
  },
  "dependencies": {
    "astro": "7.4.13",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
