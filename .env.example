# Copy to .env and fill in before a production build. Never commit .env.

# Approved destination for every "Book a conversation" button
# (for example a booking page or a contact page). Leave empty until approved:
# the buttons then scroll to the closing section and the release check fails.
PUBLIC_BOOKING_URL=

# Production origin, used for canonical and social-preview URLs.
PUBLIC_SITE_URL=

# Set to true only for the approved production launch. Anything else adds
# <meta name="robots" content="noindex, nofollow"> so previews stay out of search.
PUBLIC_ALLOW_INDEXING=false
